<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Delivery Note - {{basicdetails.[0].inv_no}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: ibmplexsansarabic;
      font-size: 10.5px;
      color: #000;
      background: #fff;
      margin: 0 5mm;
    }

    table { border-collapse: collapse; width: 100%; table-layout: fixed; }
    td, th { vertical-align: top; word-wrap: break-word; }

    /* ── Title ─────────────────────────────────────────── */
    .title {
      text-align: center;
      font-size: 18px;
      font-weight: 700;
      line-height: 22px;
      padding: 0 0 8px;
    }
    .title .en { color: #b72031; }
    .title .sl { color: #606261; }
    .title .ar { color: #606261; direction: rtl; unicode-bidi: isolate; }

    /* ── Customer / document boxes ─────────────────────── */
    .top-wrap > tbody > tr > td { border: none; padding: 0; }
    .box-tbl td { border: 1px solid #bfbfbf; padding: 6px 5px; vertical-align: middle; }
    .box-tbl td.tall { vertical-align: middle; }
    .box-tbl td.c { text-align: center; }

    /* ── Items ─────────────────────────────────────────── */
    .items { margin-top: 12px; }
    .items th {
      border: 1px solid #bfbfbf;
      font-weight: 400;
      text-align: center;
      vertical-align: middle;
      padding: 3px 4px;
      line-height: 14px;
    }
    .items th .ar { display: block; direction: rtl; unicode-bidi: isolate; }
    .items th .en { display: block; }
    .items td {
      border: 1px solid #bfbfbf;
      padding: 4px 4px;
      line-height: 14px;
    }
    .items .c { text-align: center; }
    .items .r { text-align: right; }
    .items .desc-ar { direction: rtl; unicode-bidi: isolate; }

    /* ── Footer ────────────────────────────────────────── */
    .bottom { break-inside: avoid; page-break-inside: avoid; margin-top: 36px; }
    .terms { margin-bottom: 14px; }
    .terms-title { font-weight: 700; padding: 0 0 4px; }
    .terms-body { line-height: 1.5; }
    .foot td { border: none; border-top: 1px solid #bfbfbf; padding: 18px 4px 4px; text-align: center; }
    .foot td + td { border-left: none; }

    {{#if UseBGWatermark}}
    {{#if WatermarkCss}}
    /* WATERMARK — fixed, so it repeats on every printed page (WatermarkCss = data URI built from WatermarkUrl) */
    body::after {
      content: "";
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background-image: url('{{{WatermarkCss}}}');
      background-repeat: no-repeat;
      background-position: center center;
      background-size: 100% auto;
      opacity: 0.7;
      /* watermark images differ per company (white / coloured background, and the
         service dims non-PNG ones): multiply drops a white background, brightness
         undoes the service's 0.7 dimming, so no grey wash covers the page */
      mix-blend-mode: multiply;
      filter: brightness(1.6);
      pointer-events: none;
      z-index: -1;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    {{/if}}
    {{/if}}
  </style>
</head>
<body>

  <div class="title"><span class="en">Delivery Note</span> <span class="sl">/</span> <span class="ar">مذكرة تسليم</span></div>

  <!-- CUSTOMER + DOCUMENT DETAILS -->
  <table class="top-wrap">
    <colgroup>
      <col style="width:58%">
      <col style="width:2%">
      <col style="width:40%">
    </colgroup>
    <tr>
      <td>
        <table class="box-tbl">
          <colgroup><col style="width:25%"><col style="width:75%"></colgroup>
          <tr><td class="tall">Customer Name</td><td class="tall">
            {{basicdetails.[0].customer_name}}
            {{#with billing_address.[0]}}
            {{#if address_line1}}<br>{{address_line1}}{{/if}}
            {{#if address_line2}}<br>{{address_line2}}{{/if}}
            {{#if address_line3}}<br>{{address_line3}}{{/if}}
            {{#if address_line4}}<br>{{address_line4}}{{/if}}
            {{#if address_line5}}<br>{{address_line5}}{{/if}}
            {{#if address_code}}<br>{{address_code}}{{/if}}
            {{#if vat}}<br>VAT: {{vat}}{{/if}}
            {{/with}}
          </td></tr>
          <tr><td>Date</td><td>{{basicdetails.[0].inv_date}}</td></tr>
        </table>
      </td>
      <td></td>
      <td>
        <table class="box-tbl">
          <colgroup><col style="width:38%"><col style="width:62%"></colgroup>
          <tr><td>DN Number</td><td class="c">{{basicdetails.[0].inv_no}}</td></tr>
          <tr><td>Invoice No</td><td class="c">{{basicdetails.[0].invoice_no}}</td></tr>
          <tr><td>PO No</td><td class="c">{{basicdetails.[0].order_no}}</td></tr>
        </table>
      </td>
    </tr>
  </table>

  <!-- ITEMS -->
  <table class="items">
    <colgroup>
      <col style="width:5%">
      <col style="width:75%">
      <col style="width:10%">
      <col style="width:10%">
    </colgroup>
    <thead>
      <tr>
        <th><span class="ar">م</span><span class="en">S.N</span></th>
        <th><span class="ar">الوصف</span><span class="en">Description</span></th>
        <th><span class="ar">الكمية</span><span class="en">QTY</span></th>
        <th><span class="ar">وحدة</span><span class="en">Unit</span></th>
      </tr>
    </thead>
    <tbody>
      {{#each itemdetails}}
      <tr>
        <td class="c">{{addOne @index}}</td>
        <td>{{item_name}}{{#if name_lang2}} <span class="desc-ar">{{name_lang2}}</span>{{/if}}{{#if description}} {{description}}{{/if}}</td>
        <td class="r">{{quantity}}</td>
        <td class="r">{{unit}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- PREPARED / DELIVERED / RECEIVED BY — kept together: moves to the next page if it doesn't fit -->
  <div class="bottom">
  {{#if basicdetails.[0].terms_and_condition}}
  <div class="terms">
    <div class="terms-title">Terms &amp; Conditions</div>
    <div class="terms-body">{{{nl2br basicdetails.[0].terms_and_condition}}}</div>
  </div>
  {{/if}}
  <table class="foot">
    <colgroup>
      <col style="width:34%">
      <col style="width:33%">
      <col style="width:33%">
    </colgroup>
    <tr>
      <td>Prepared By</td>
      <td>Delivered By</td>
      <td>Received By</td>
    </tr>
  </table>
  </div>

</body>
</html>
