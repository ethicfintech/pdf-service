<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Delivery Note - {{basicdetails.[0].inv_no}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: ibmplexsansarabic;
      font-size: 12px;
      color: #000;
      background: #fff;
      margin: 0 5mm;
    }

    table { border-collapse: collapse; width: 100%; table-layout: fixed; }

    /* ── Title ─────────────────────────────────────────── */
    .title {
      text-align: center;
      font-size: 16px;
      font-weight: 700;
      padding: 7px 0 19px;
    }
    .title .en { color: #b72031; }
    .title .ar { color: #606261; direction: rtl; unicode-bidi: isolate; }

    /* ── Header boxes: customer (left) + document (right) ── */
    .hdr-wrap > tbody > tr > td { border: none; padding: 0; vertical-align: top; }

    .info td {
      border: 1px solid #bfbfbf;
      padding: 1px 6px;
      line-height: 18.3px;
      vertical-align: top;
      word-wrap: break-word;
    }
    .info .val-c { text-align: center; }

    /* ── Items ─────────────────────────────────────────── */
    .items { margin-top: 9px; }   /* height follows the number of items */
    .items th {
      border: 1px solid #bfbfbf;
      padding: 1.5px 4px;
      font-weight: 400;
      text-align: center;
      vertical-align: middle;
      line-height: 14px;
    }
    .items th .ar { display: block; direction: rtl; unicode-bidi: isolate; line-height: 15.6px; }
    .items th .en { display: block; line-height: 12.4px; }
    .items td {
      border: 1px solid #bfbfbf;
      padding: 4px 5px;
      vertical-align: top;
      line-height: 12px;
    }
    /* no rule between item rows — the column rules run to the foot of the grid */
    .items tbody td { border-top: none; border-bottom: none; }
    .items .sn  { text-align: center; }
    .items .qty { text-align: center; padding-right: 9px; }
    .items .uom { text-align: center; padding-right: 9px; }
    .items .desc-ar { direction: rtl; unicode-bidi: isolate; }

    /* ── Foot ──────────────────────────────────────────── */
    .foot td {
      border: none;
      padding: 1px 6px 0;
      text-align: center;
    }
  </style>
</head>
<body>

  <!-- TITLE -->
  <div class="title">
    <span class="en">Delivery Note /</span> <span class="ar">مذكرة تسليم</span>
  </div>

  <!-- HEADER BOXES -->
  <table class="hdr-wrap">
    <colgroup>
      <col style="width:57.8%">
      <col style="width:2.4%">
      <col style="width:39.6%">
    </colgroup>
    <tr>
      <td>
        <table class="info">
          <colgroup>
            <col style="width:30%">
            <col style="width:70%">
          </colgroup>
          <tr>
            <td>Customer Name</td>
            <td>{{billing_address.[0].name}}</td>
          </tr>
          <tr>
            <td>Contact Name</td>
            <td>{{basicdetails.[0].attention}}</td>
          </tr>
          <tr>
            <td>Contact Number</td>
            <td>{{customer_details.[0].contact_no1}}</td>
          </tr>
          <tr>
            <td>Date</td>
            <td>{{basicdetails.[0].inv_date}}</td>
          </tr>
        </table>
      </td>
      <td></td>
      <td>
        <table class="info">
          <colgroup>
            <col style="width:30%">
            <col style="width:70%">
          </colgroup>
          <tr>
            <td>DN Number</td>
            <td class="val-c">{{basicdetails.[0].inv_no}}</td>
          </tr>
          <tr>
            <td>Reference No</td>
            <td class="val-c">{{basicdetails.[0].reference_no}}</td>
          </tr>
          <tr>
            <td>PO No</td>
            <td class="val-c">{{basicdetails.[0].order_no}}</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <!-- ITEMS -->
  <table class="items">
    <colgroup>
      <col style="width:5%">
      <col style="width:75%">
      <col style="width:10%">
      <col style="width:10%">
    </colgroup>
    <thead>
      <tr>
        <th><span class="ar">م</span><span class="en">S.N</span></th>
        <th><span class="ar">الوصف</span><span class="en">Description</span></th>
        <th><span class="ar">الكمية</span><span class="en">QTY</span></th>
        <th><span class="ar">الوحدة</span><span class="en">UOM</span></th>
      </tr>
    </thead>
    <tbody>
      {{#each itemdetails}}
      <tr>
        <td class="sn">{{addOne @index}}</td>
        <td>{{item_name}}{{#if name_lang2}}<span class="desc-ar">{{name_lang2}}</span>{{/if}}{{#if description}}<span class="desc-ar">{{description}}</span>{{/if}}</td>
        <td class="qty">{{quantity}}</td>
        <td class="uom">{{unit}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- FOOT -->
  <table class="foot">
    <colgroup>
      <col style="width:50%">
      <col style="width:50%">
    </colgroup>
    <tr>
      <td>DELIVERED</td>
      <td>RECEIVED BY</td>
    </tr>
  </table>

</body>
</html>
