<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>INVOICE - {{basicdetails.[0].inv_no}}</title>
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: ibmplexsansarabic;
        font-size: 10px;
        line-height: 1.4;
        color: #000;
        margin: 0 4mm;
      }

      /* grey shading hugs the text only; the rule runs the full page width */
      .invoice-title {
        text-align: center;
        padding: 4px 0 10px;
        border-bottom: 1px solid #000;
      }
      .invoice-title .chip {
        display: inline-block;
        background-color:#dbe0e5;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 0.4px;
        padding: 5px 16px;
      }
      .invoice-title .ar {
        direction: rtl;
        unicode-bidi: isolate;
      }

      .invoice-no-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px 6px;
        font-size: 10.5px;
        font-weight: 600;
        margin-top: 2px;
        margin-bottom: 2px;
        background-color:#dbe0e5;
      }
      .invoice-no-bar .ar { direction: rtl; }

      .section-label {
        display: flex;
        justify-content: space-between;
        margin-top: 6px;
        padding: 3px 4px;
        font-size: 10.5px;
        border: 1px solid #bfbfbf;
        border-bottom: none;
      }
      .section-label .ar { direction: rtl; }

      .details-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 9.5px;
        table-layout: fixed;
      }
      .details-table td {
        border: 1px solid #bfbfbf;
        padding: 3px 6px;
        vertical-align: middle;
        overflow: hidden;
      }
      .details-table col.c1 { width: 9%; }
      .details-table col.c2 { width: 15%; }
      .details-table col.c3 { width: 8%; }
      .details-table col.c4 { width: 14%; }
      .details-table col.c5 { width: 17%; }
      .details-table col.c6 { width: 8%; }
      .details-table col.c7 { width: 15%; }
      .details-table col.c8 { width: 7%; }

      .details-table .lbl {
        font-size: 9px;
      }
      .details-table .lbl-ar {
        text-align: right;
        direction: rtl;
        font-size: 9px;
      }
      .details-table .val-ar {
        text-align: right;
        direction: rtl;
        font-size: 9px;
      }

      .meta-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 6px;
        font-size: 9.5px;
      }
      .meta-table th {
        
        font-weight: 700;
        text-align: center;
        padding: 4px 3px;
        border: 1px solid #bfbfbf;
        line-height: 1.45;
        direction: rtl;
      }
      .meta-table th .en {
        display: block;
        direction: ltr;
        font-weight: 600;
        font-size: 9px;
      }
      .meta-table td {
        text-align: center;
        padding: 4px 3px;
        border: 1px solid #bfbfbf;
        font-size: 9.5px;
      }

      .items-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 6px;
        font-size: 9px;
      }
      .items-table th {
        
        text-align: center;
        padding: 4px 3px;
        background-color:#dbe0e5;
        border: 1px solid #bfbfbf;
        border-bottom: none;
        line-height: 1.4;
        vertical-align: middle;
      }
      .items-table th .ar {
        display: block;
        direction: rtl;
        font-size: 9px;
      }
      .items-table th .en {
        display: block;
        direction: ltr;
        font-size: 8.5px;
      }
      .items-table td {
        padding: 4px 4px;
        border: 1px solid #bfbfbf;
        vertical-align: middle;
      }
      .items-table .desc-cell {
        text-align: left;
        padding: 4px 6px;
        font-size: 9px;
        line-height: 1.5;
      }
      .items-table .desc-cell .sub-ar {
        direction: rtl;
        font-size: 9px;
        color: #444;
      }

      .totals-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 6px;
        font-size: 10px;
        table-layout: fixed;
      }
      .totals-table td {
        padding: 5px 10px;
        border: 1px solid #bfbfbf;
        vertical-align: middle;
      }
      .totals-table .qr-total-cell {
        width: 16%;
        text-align: center;
        vertical-align: middle;
        padding: 6px !important;
      }
      .totals-table .qr-total-cell .qr-placeholder {
        width: 100px;
        height: 100px;   /* square — the QR png is 1:1, 95px cropped its bottom row */
        margin: 0 auto;
      }
      .totals-table .tot-lbl-en {
        width: 25%;
        font-weight: 700;
        background-color:#dbe0e5;
      }
      .totals-table .tot-lbl-ar {
        font-weight: 700;
        width: 44%;
        text-align: right;
        direction: rtl;
      }
      .totals-table .tot-val {
        font-weight: 700;
        width: 12%;
        text-align: right;
      }
      .amount-table{
        width: 100%;
        border-collapse: collapse;
        margin-top: 6px;
        font-size: 10px;
        table-layout: fixed;
        padding: 8px 10px;
        border: 1px solid #bfbfbf;
      }
      .amount-table .words-cell {
        padding: 8px 10px;
        line-height: 1.6;
        font-weight: 600;
      }

      .bank-outer-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 10px;
        margin-top: 6px;
        page-break-inside: avoid;
        break-inside: avoid;
      }
      .bank-outer-table thead { display: table-row-group; }
      .bank-outer-table tr,
      .bank-outer-table td,
      .bank-outer-table th {
        page-break-inside: avoid;
        break-inside: avoid;
      }
      .bank-outer-table th {
        text-align: center;
        padding: 5px 6px;
        font-weight: 700;
        font-size: 10px;
        border: 1px solid #bfbfbf;
        background-color: #dbe0e5;
      }
      .bank-outer-table th.bank-head {
        text-align: center;
        padding: 5px 6px;
      }
      .bank-outer-table th.bank-head .ar {
        direction: rtl;
      }
      .bank-outer-table td {
        vertical-align: top;
        padding: 0;
        border: 1px solid #bfbfbf;
      }
      /* a definite (tiny) height on the cell is what lets the nested table's
         height:100% resolve — the cell itself still grows to the row */
      .bank-outer-table td.bank-cell {
        height: 1px;
      }
      .bank-inner-table {
        width: 100%;
        height: 100%;              /* fill the cell — no blank strip under the last row */
        border-collapse: collapse;
        font-size: 9px;
      }
      .bank-inner-table td {
        border: 1px solid #bfbfbf;
        padding: 5px 6px;
        vertical-align: middle;
      }
      .bank-inner-table .bk-lbl {
        width: 40%;
        font-weight: 700;
        line-height: 1.35;
      }
      .bank-inner-table .bk-val {
        width: 60%;
        direction: ltr;
        text-align: left;
        line-height: 1.35;
      }

      .sig-cell {
        width: 22%;
        text-align: center;
        vertical-align: bottom !important;
        padding: 6px !important;
        height: 122px;
      }
      .sig-area {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: stretch;   /* children span the cell, so % sizes resolve */
        height: 100%;
        gap: 4px;
      }
      .stamp-circle img { object-fit: contain; }
      /* Fixed slot above the caption: keeps all three columns the same height
         whether or not the seal / signature is switched on. width/height are
         both definite so the image's max-width/max-height percentages have a
         box to resolve against — without that the slot shrink-wraps the image
         and the artwork spills out and gets clipped. */
      .sig-img-slot {
        width: 100%;
        /* dynamic: follows the seal/signature size settings (d459 / d458), but
           clamped so a large value can't blow the row out or a tiny one
           collapse it. All three columns share one height, so the captions
           stay on the same baseline. */
        height: clamp(46px, max({{default datasettings.d459 '70'}}px, {{default datasettings.d458 '70'}}px), 110px);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      /* contain (never cover) so the whole stamp/signature is always visible,
         whatever its aspect ratio — it scales down to fit, never crops */
      .sig-img-slot img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
      }
      .sig-label {
        font-size: 9px;
        color: #000;
        text-align: center;
        line-height: 1.25;
        font-weight: 600;
      }
      .sig-label .ar-line {
        direction: rtl;
        display: block;   /* block already breaks the line — no <br/> needed */
      }

      .qr-cell {
        width: 14%;
        text-align: center;
        vertical-align: middle !important;
        padding: 0px !important;
      }
      .qr-placeholder {
        width: 120px;
        height: 120px;
        margin: 0 auto;
        overflow: hidden;
      }
      .qr-placeholder img {
        width: 100%;
        height: auto;
        max-width: 120px;
        max-height: 120px;
      }
    </style>
  </head>
  <body>

    <!-- TITLE -->
    <div class="invoice-title">
      <span class="chip">{{basicdetails.[0].documentheader}}&nbsp;/&nbsp;<span class="ar"> {{basicdetails.[0].documentheader_lang2}}</span></span>
    </div>
    </br>
    <!-- INVOICE NO BAR -->
    <div class="invoice-no-bar">
      <span><strong>Invoice No:</strong>&nbsp; {{basicdetails.[0].inv_no}}</span>
      <span class="ar"><strong>رقم الفاتورة :</strong>&nbsp; {{#if basicdetails.[0].inv_no_arabic}}{{basicdetails.[0].inv_no_arabic}}{{/if}}</span>
    </div>

    <!-- FROM (COMPANY) SECTION -->
    {{#ifFlag datasettings "d570"}}
    <div class="section-label">
      <span><u>From :</u></span>
      <span class="ar"><u>من :</u></span>
    </div>
    <table class="details-table">
      <colgroup>
        <col class="c1" /><col class="c2" /><col class="c3" /><col class="c4" />
        <col class="c5" /><col class="c6" /><col class="c7" /><col class="c8" />
      </colgroup>
      <tbody>
        <tr>
          <td class="lbl" style="background-color:#dbe0e5;">Name</td>
          <td colspan="3" style="background-color:#dbe0e5;"><b>{{branch.[0].name}}</b></td>
          <td colspan="3" style="background-color:#dbe0e5;" class="val-ar"><b>{{branch_lang2.[0].name}}</b></td>
          <td class="lbl-ar" style="background-color:#dbe0e5;"><b>الاسم</b></td>
        </tr>
        <tr>
          <td class="lbl">Street Name</td>
          <td colspan="3">{{branch.[0].address_line2}}</td>
          <td colspan="3" class="val-ar">{{branch_lang2.[0].address_line2}}</td>
          <td class="lbl-ar">اسم الشارع</td>
        </tr>
        <tr>
          <td class="lbl">Building No</td>
          <td>{{branch.[0].address_line1}}</td>
          <td class="lbl">City</td>
          <td>{{branch.[0].address_line4}}</td>
          <td class="val-ar">{{branch_lang2.[0].address_line4}}</td>
          <td class="lbl-ar">مدينة</td>
          <td class="val-ar">{{branch_lang2.[0].address_line1}}</td>
          <td class="lbl-ar">رقم المبنى</td>
        </tr>
        <tr>
          <td class="lbl">Addl. No</td>
          <td>{{branch.[0].additional_no}}</td>
          <td class="lbl">District</td>
          <td>{{branch.[0].address_line3}}</td>
          <td class="val-ar">{{branch_lang2.[0].address_line3}}</td>
          <td class="lbl-ar">الحي</td>
          <td class="val-ar">{{branch_lang2.[0].additional_no}}</td>
          <td class="lbl-ar">رقم إضافي</td>
        </tr>
        <tr>
          <td class="lbl">Postal Code</td>
          <td>{{branch.[0].address_code}}</td>
          <td class="lbl">Country</td>
          <td>{{branch.[0].address_line5}}</td>
          <td class="val-ar">{{branch_lang2.[0].address_line5}}</td>
          <td class="lbl-ar">البلد</td>
          <td class="val-ar">{{branch_lang2.[0].address_code}}</td>
          <td class="lbl-ar">رمز بريدي</td>
        </tr>
        <tr>
          <td class="lbl">VAT Number</td>
          <td>{{branch.[0].vat}}</td>
          <td class="lbl">CRN</td>
          <td>{{branch.[0].cr_no}}</td>
          <td class="val-ar">{{branch_lang2.[0].cr_no}}</td>
          <td class="lbl-ar">السجل التجاري</td>
          <td class="val-ar">{{branch_lang2.[0].vat}}</td>
          <td class="lbl-ar">رقم ضريبة</td>
        </tr>
      </tbody>
    </table>
    {{/ifFlag}}


    <!-- CLIENT DETAILS SECTION -->
    <div class="section-label">
      <span><u>Client Details :</u></span>
      <span class="ar"><u> تفاصيل العميل  :</u></span>
    </div>
    <table class="details-table">
      <colgroup>
        <col class="c1" />
        <col class="c2" />
        <col class="c3" />
        <col class="c4" />
        <col class="c5" />
        <col class="c6" />
        <col class="c7" />
        <col class="c8" />
      </colgroup>
      <tbody>
        <tr>
          <td class="lbl" style="background-color:#dbe0e5;">Name</td>
          <td colspan="3" style="background-color:#dbe0e5;"><b>{{billing_address.[0].name}}</b></td>
          <td colspan="3" style="background-color:#dbe0e5;" class="val-ar"><b>{{billing_address_lang2.[0].name}}</b></td>
          <td class="lbl-ar" style="background-color:#dbe0e5;"><b>الاسم</b></td>
        </tr>
        <tr>
          <td class="lbl">Street Name</td>
          <td colspan="3">{{billing_address.[0].address_line2}}</td>
          <td colspan="3" class="val-ar">{{billing_address_lang2.[0].address_line2}}</td>
          <td class="lbl-ar">اسم الشارع</td>
        </tr>
        <tr>
          <td class="lbl">Building No</td>
          <td>{{billing_address.[0].address_line1}}</td>
          <td class="lbl">City</td>
          <td>{{billing_address.[0].address_line4}}</td>
          <td class="val-ar">{{billing_address_lang2.[0].address_line4}}</td>
          <td class="lbl-ar">مدينة</td>
          <td class="val-ar">{{billing_address_lang2.[0].address_line1}}</td>
          <td class="lbl-ar">رقم المبنى</td>
        </tr>
        <tr>
          <td class="lbl">Addl. No</td>
          <td>{{customer_details.[0].additional_no}}</td>
          <td class="lbl">District</td>
          <td>{{billing_address.[0].address_line3}}</td>
          <td class="val-ar">{{billing_address_lang2.[0].address_line3}}</td>
          <td class="lbl-ar">الحي</td>
          <td class="val-ar">{{customer_details.[0].additional_no_lang2}}</td>
          <td class="lbl-ar">رقم إضافي</td>
        </tr>
        <tr>
          <td class="lbl">Postal Code</td>
          <td>{{billing_address.[0].address_code}}</td>
          <td class="lbl">Country</td>
          <td>{{billing_address.[0].address_line5}}</td>
          <td class="val-ar">{{billing_address_lang2.[0].address_line5}}</td>
          <td class="lbl-ar">البلد</td>
          <td class="val-ar">{{billing_address_lang2.[0].address_code}}</td>
          <td class="lbl-ar">رمز بريدي</td>
        </tr>
        <tr>
          <td class="lbl">VAT Number</td>
          <td>{{billing_address.[0].vat}}</td>
          <td class="lbl">CRN</td>
          <td>{{customer_details.[0].cr_no}}</td>
          <td class="val-ar">{{customer_details.[0].cr_no_lang2}}</td>
          <td class="lbl-ar">السجل التجاري</td>
          <td class="val-ar">{{billing_address_lang2.[0].vat}}</td>
          <td class="lbl-ar">رقم ضريبة</td>
        </tr>
      </tbody>
    </table>

    <!-- META TABLE (dates) -->
    <table class="meta-table">
        <tr>
          <td>تاريخ الفاتورة </br>
            <span class="en">Invoice Date</span></br>
            <span>{{basicdetails.[0].inv_date}}</span>
          </td>
          <td>تاريخ التسليم </br>
            <span class="en">Supply Date</span></br>
            <span>{{basicdetails.[0].sup_date}}</span>
          </td>
          <td>رقم أمر الشراء </br>
            <span class="en">Contract / PO No</span></br>
            <span>{{basicdetails.[0].order_no}}</span>
          </td>
          {{#ifFlag datasettings "d509"}}
          <td>تاريخ الاستحقاق </br>
            <span class="en">Due Date</span></br>
            <span>{{basicdetails.[0].due_date}}</span>
          </td>
          {{/ifFlag}}
          {{#ifFlag datasettings "d515"}}
          <td>رقم المرجع </br>
            <span class="en">Reference No</span></br>
            <span>{{basicdetails.[0].reference_no}}</span>
          </td>
          {{/ifFlag}}
          {{#ifFlag datasettings "d517"}}
          <td>مندوب المبيعات </br>
            <span class="en">Sales Person</span></br>
            <span>{{basicdetails.[0].salesman_name}}</span>
          </td>
          {{/ifFlag}}
          {{#ifFlag datasettings "d627"}}
          <td> طريقة الدفع </br>
            <span class="en">Mode Of Payment</span></br>
            <span>{{basicdetails.[0].doc_payment_status}} / {{basicdetails.[0].doc_payment_status_lang2}} </span>
          </td>
          {{/ifFlag}}
        </tr>
    </table>

    <!-- ITEMS TABLE -->
    <table class="items-table">
      <thead>
        <tr>
          <th style="width:3%">
            <span class="ar">م</span>
            <span class="en">#</span>
          </th>
          {{#if itemdetails.[0].item_code}}
          <th style="width:11%">
            <span class="ar">الرمز</span>
            <span class="en"> Code (SKU)</span>
          </th>
          {{/if}}
          <th style="width:{{#if itemdetails.[0].item_code}}{{#ifFlag datasettings "d540"}}26%{{else}}33%{{/ifFlag}}{{else}}{{#ifFlag datasettings "d540"}}37%{{else}}44%{{/ifFlag}}{{/if}}">
            <span class="ar">طبيعة السلعة/الخدمة</span>
            <span class="en">Nature of Goods / Services</span>
          </th>
          <th style="width:6%">
            <span class="ar">الوحدة</span>
            <span class="en">Unit</span>
          </th>
          <th style="width:7%">
            <span class="ar">الكمية</span>
            <span class="en">QTY</span>
          </th>
          <th style="width:8%">
            <span class="ar">المعدل</span>
            <span class="en">Rate</span>
          </th>
          <th style="width:12%">
            <span class="ar">الإجمالي بدون ضريبة</span>
            <span class="en">Amount Excl. VAT</span>
          </th>
          {{#ifFlag datasettings "d540"}}
          <th style="width:7%">
            <span class="ar"> ضريبةالمضاف</span>
            <span class="en">VAT %</span>
          </th>
          {{/ifFlag}}
          <th style="width:8%">
            <span class="ar"> قيمة الضريبة</span>
            <span class="en">VAT Amount</span>
          </th>
          <th style="width:12%">
            <span class="ar"> المبلغ الإجمالي</span>
            <span class="en">Amount Incl. VAT</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {{#each itemdetails}}
        <tr>
          <td style="text-align:center;">{{addOne @index}}</td>
          {{#if @root.itemdetails.[0].item_code}}
          <td style="text-align:left;">{{item_code}}</td>
          {{/if}}
          <td class="desc-cell">
            {{item_name}}
            {{#if name_lang2}}<div class="sub-ar">{{name_lang2}}</div>{{/if}}
            {{#if description}}<div>{{description}}</div>{{/if}}
          </td>
          <td style="text-align:center;">{{unit}}</td>
          <td style="text-align:center;">{{formatAmount quantity ../bcdp}}</td>
          <td style="text-align:right;">{{formatAmount price ../bcdp}}</td>
          <td style="text-align:right;">{{formatAmount taxable ../bcdp}}</td>
          {{#ifFlag @root.datasettings "d540"}}
          <td style="text-align:center;">{{vat_perc}} %</td>
          {{/ifFlag}}
          <td style="text-align:right;">{{formatAmount vat_amt ../bcdp}}</td>
          <td style="text-align:right;">{{formatAmount amount ../bcdp}}</td>
        </tr>
        {{/each}}
        <tr>
          <td colspan="{{#if itemdetails.[0].item_code}}{{#ifFlag datasettings "d540"}}10{{else}}9{{/ifFlag}}{{else}}{{#ifFlag datasettings "d540"}}9{{else}}8{{/ifFlag}}{{/if}}" style="text-align:center;">***** لا شيء يبدأ *****</td>
        </tr>
      </tbody>
    </table>

    <!-- TOTALS -->
    <table class="totals-table">
      <tbody>
        <tr>
          <td rowspan="{{#if (gt basicdetails.[0].received 0)}}6{{else}}4{{/if}}" class="qr-total-cell">
            <div class="qr-placeholder">{{{qrDataUri qrCodeBase64}}}</div>
          </td>
          <td class="tot-lbl-en">Total Excl. VAT ({{basicdetails.[0].base_country_isocode}})</td>
          <td class="tot-lbl-ar">الإجمالي باستثناء ضريبة القيمة المضافة</td>
          <td class="tot-val">{{formatAmount (divide basicdetails.[0].subtotal ccrate) bcdp}}</td>
        </tr>
        {{#if zatcadiscount.[0]}}
        {{#each zatcadiscount}}
        <tr>
              <td class="tot-lbl-en">{{reason_name}}</td>
              <td class="tot-lbl-ar">{{reason_name_lang2}}</td>
              <td class="tot-val">{{formatAmount (divide dld ../ccrate) bcdp}}</td>
            </tr>
        {{/each}}
        {{else}}

            {{#if (or basicdetails.[0].discount basicdetails.[0].dld)}}
            <tr>
              <td class="tot-lbl-en">Total Discount</td>
              <td class="tot-lbl-ar">الخصم الإجمالي</td>
              <td class="tot-val">{{formatAmount (divide (add basicdetails.[0].discount basicdetails.[0].dld) ccrate) bcdp}}</td>
            </tr>
        {{/if}}
    {{/if}}
        <tr>
          <td class="tot-lbl-en">VAT ({{basicdetails.[0].base_country_isocode}})</td>
          <td class="tot-lbl-ar">ضريبة القيمة المضافة </td>
          <td class="tot-val">{{formatAmount (divide basicdetails.[0].vatamt ccrate) bcdp}}</td>
        </tr>
        <tr style="font-weight: bold;">
          <td class="tot-lbl-en">Amount Incl. VAT ({{basicdetails.[0].base_country_isocode}})</td>
          <td class="tot-lbl-ar">المبلغ بما في ذلك ضريبة القيمة المضافة </td>
          <td class="tot-val">{{formatAmount (divide basicdetails.[0].grand_total ccrate) bcdp}}</td>
        </tr>
        {{#if (gt basicdetails.[0].received 0)}}
        <tr>
          <td class="tot-lbl-en">Payment Made</td>
          <td class="tot-lbl-ar">تم الدفع</td>
          <td class="tot-val">{{formatAmount (divide basicdetails.[0].received ccrate) bcdp}}</td>
        </tr>
        <tr>
          <td class="tot-lbl-en">Balance Due</td>
          <td class="tot-lbl-ar">الرصيد المستحق</td>
          <td class="tot-val">{{formatAmount (divide basicdetails.[0].balance ccrate) bcdp}}</td>
        </tr>
        {{/if}}
      </tbody>
    </table>
    <table class="amount-table" style="border: 1px solid #bfbfbf;">
        <tr>
          <td class="words-cell">
            <div>Amount in Words : {{bcamountinwords}}</div>
            <div class="ar-words">{{bcamountinwordsar}}</div>
          </td>
        </tr>
    </table>
    <!-- BANK / SIGNATURES -->
    <table class="bank-outer-table">
      <thead>
        <tr>
          <th class="bank-head" style="width: 45%;">
            Bank Details&nbsp;/&nbsp;<span class="ar">التفاصيل المصرفية</span>
          </th>
          <th style="width: {{#ifFlag datasettings "d576"}}19%{{else}}28%{{/ifFlag}};">Prepared By</th>
          {{#ifFlag datasettings "d576"}}
          <th style="width: 19%;">Approved By</th>
          {{/ifFlag}}
          <th style="width: {{#ifFlag datasettings "d576"}}17%{{else}}27%{{/ifFlag}};">Received By</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="bank-cell">
            <table class="bank-inner-table">
              <tr>
                <td class="bk-lbl">Account Name / إسم الحساب</td>
                <td class="bk-val">{{bankdetails.acc_name}}</td>
              </tr>
              <tr>
                <td class="bk-lbl">Bank Name / اسم البنك</td>
                <td class="bk-val">{{bankdetails.name}}</td>
              </tr>
              <tr>
                <td class="bk-lbl">Account Number / رقم حساب</td>
                <td class="bk-val">{{bankdetails.acc_no}}</td>
              </tr>
              <tr>
                <td class="bk-lbl">IBAN No / رقم الآيبان</td>
                <td class="bk-val">{{bankdetails.iban_no}}</td>
              </tr>
              <tr>
                <td class="bk-lbl">Branch Name / اسم الفرع</td>
                <td class="bk-val">{{bankdetails.branch_name}}</td>
              </tr>
            </table>
          </td>
          <td class="sig-cell">
            <div class="sig-area">
              <div class="sig-img-slot">
                {{#ifFlag datasettings "d146"}}<img class="seal-img" src="{{Seal}}" alt="Seal" style="max-height:min({{default datasettings.d458 '120'}}px,100%); max-width:min({{default datasettings.d458 '120'}}px,100%);" onerror="this.style.display='none'"/>{{/ifFlag}}
              </div>
                <div class="sig-label">
                  {{#ifFlag datasettings "d146"}}<span class="ar-line">الختم</span>Stamp{{else}}<span class="ar-line">التوقيع مع الختم</span>Signature with stamp{{/ifFlag}}
                </div>
            </div>
          </td>
          {{#ifFlag datasettings "d576"}}
          <td class="sig-cell">
            <div class="sig-area">
              <div class="sig-img-slot">
                {{#ifFlag datasettings "d165"}}<img class="Signature" src="{{Signature}}" alt="Signature" style="max-height:min({{default datasettings.d459 '120'}}px,100%); max-width:min({{default datasettings.d459 '120'}}px,100%);" onerror="this.style.display='none'"/>{{/ifFlag}}
              </div>
              <div class="sig-label">
                {{#ifFlag datasettings "d165"}}<span class="ar-line">التوقيع</span>Signature{{else}}<span class="ar-line">التوقيع مع الختم</span>Signature with stamp{{/ifFlag}}
              </div>
            </div>
          </td>
          {{/ifFlag}}
          <td class="sig-cell">
            <div class="sig-area">
              <div class="sig-img-slot"></div>
              <div class="sig-label">
                <span class="ar-line">التوقيع مع الختم</span>
                Signature with stamp
              </div>
            </div>
          </td>
        </tr>
      </tbody>
    </table>

  </body>
</html>
