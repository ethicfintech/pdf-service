<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<title>Invoice - {{basicdetails.[0].inv_no}}</title>
<style>
    
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: ibmplexsansarabic;
        font-size: 10px;
        line-height: 1.4;
        color: #000;
        margin: 0 4mm;
      }
    table{
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 10px;
        color: #000;
    }
    td, th{
        font-size: 10px;
        word-wrap: break-word;
    }
    .arab{
        font-family: 'ibmplexsansarabic', 'Cairo', 'Noto Sans Arabic', sans-serif;
    }
    .bg-l{ background-color: #E8ECEF; }
    .tc{ text-align: center; }
    .ts{ text-align: left; }
    .te{ text-align: right; }
    .b{ font-weight: bold; }

    /* ── Title ─────────────────────────────────────────── */
    .doc_head{
        text-align: center;
        font-weight: bold;
        font-size: 19px;
        color: #553838;
        line-height: 22px;
        padding: 2px 0 3px 0;
    }

    /* ── Invoice no bar (top rule only) ────────────────── */
    .invno_tab td{
        border-top: 1px solid #553838;
        font-size: 10px;
        font-weight: bold;
        padding: 3px 2px;
        line-height: 14px;
    }

    /* ── Generic bordered blocks ───────────────────────── */
    .sec{
        border: 1px solid #bfbfbf;
        margin-top: 2px;
    }
    .sec td, .sec th{
        border: 1px solid #bfbfbf;
        vertical-align: middle;
    }
    /* Header blocks — dotted inner rules; the solid table border wins
       on the outer frame under border-collapse (solid beats dotted). */
    .dates td, .dates th,
    .detail td, .detail th{
        border: 1px dotted #bfbfbf;
    }

    /* ── Date / reference strip ────────────────────────── */
    .dates th{
        padding: 1px 3px;
        line-height: 12px;
        font-size: 10px;
        font-weight: bold;
        text-align: center;
        background-color: #E8ECEF;
    }
    .dates th span{
        display: block;
        font-weight: normal;
        font-size: 9px;
        line-height: 12px;
    }
    .dates td{
        padding: 2px 3px;
        line-height: 13px;
        text-align: center;
    }

    /* ── Our / Customer details ────────────────────────── */
    .detail td{
        padding: 2px 5px;
        line-height: 15px;
    }
    /* Arabic row captions — sized to stay on a single line */
    .detail td.bg-l{
        padding: 2px 3px;
        white-space: nowrap;
    }
    .detail td.bg-l.arab{
        font-size: 9px;
    }
    .detail .sec_hd{
        border-left: 0;
        border-right: 0;
        font-weight: bold;
        padding: 1px 5px;
        line-height: 14px;
    }
    .detail .sec_hd .rt{
        float: right;
    }

    /* project line above the items table */
    .proj_line{
        padding: 4px 2px 0 2px;
        line-height: 14px;
    }

    /* ── Items ─────────────────────────────────────────── */
    .items th{
        padding: 4px 3px;
        line-height: 13px;
        font-size: 10px;
        font-weight: bold;
        text-align: center;
        background-color: #E8ECEF;
    }
    .items th span{
        display: block;
        font-weight: normal;
        font-size: 9px;
        line-height: 13px;
    }
    .items td{
        padding: 2px 3px;
        line-height: 14px;
        vertical-align: top;
    }
    .items .sub{
        display: block;
        font-size: 9px;
        color: #444;
    }

    /* ── QR + summary ──────────────────────────────────── */
    .foot_wrap{
        margin-top: 7px;
        border-collapse: collapse;
    }
    .foot_wrap > tbody > tr > td{
        border: 0;
        padding: 0;
    }
    .qr_cell{
        width: 129px;
        text-align: center;
        vertical-align: top;
        padding-top: 12px !important;
    }
    .qr_cell img{
        width: 103px !important;
        height: 103px !important;
        margin: 0 auto;
    }
    .summary td{
        padding: 2px 5px;
        line-height: 13px;
        font-weight: bold;
    }
    .summary .amt{
        text-align: right;
        background-color: #E8ECEF;
    }
    .summary .ar{
        text-align: right;
    }
    .words{
        padding: 3px 5px !important;
        font-weight: normal;
    }
    .words .lbl{
        font-size: 10px;
        line-height: 13px;
    }
    .words .ar_w{
        text-align: center;
        font-weight: bold;
        font-size: 10px;
        line-height: 16px;
    }
    .words .en_w{
        text-align: center;
        font-weight: bold;
        font-size: 10px;
        line-height: 15px;
    }

    /* ── Bank details ──────────────────────────────────── */
    .bank{
        margin-top: 9px;
    }
    .bank th{
        padding: 2px 5px;
        line-height: 13px;
        font-size: 10px;
        font-weight: bold;
        text-align: center;
        background-color: #E8ECEF;
    }
    .bank td{
        padding: 5px;
        line-height: 14px;
    }
    .bank .bval{
        font-weight: bold;
    }
    .bank .sig{
        text-align: center;
        vertical-align: middle;
    }
    .bank .sig img{
        max-height: 90px;
        max-width: 90%;
    }
    .bank .sig_lbl{
        text-align: center;
        font-weight: bold;
        line-height: 13px;
        padding: 0 5px 1px 5px;
        /* no rule between the signature area and its caption — a collapsed edge
           draws if EITHER side declares it, so .sig drops its bottom too */
        border-top: 0;
    }
    .bank .sig{ border-bottom: 0; }
</style>
</head>
<body>

    {{!-- ── Title ─────────────────────────────────────── --}}
    <div class="doc_head">TAX INVOICE / <span class="arab">فاتورة ضريبية</span></div>

    {{!-- ── Invoice number bar ────────────────────────── --}}
    <table class="invno_tab">
        <tr>
            <td class="ts">■ Invoice No: &nbsp;{{basicdetails.[0].inv_no}}</td>
            <td class="te arab" dir="rtl">■ رقم الفاتورة : {{basicdetails.[0].inv_no_arabic}}</td>
        </tr>
    </table>

    {{!-- ── Date / reference strip ────────────────────── --}}
    <table class="sec dates">
        <colgroup>
            <col style="width:10%"><col style="width:20%">
            <col style="width:19%">
            {{!-- PO Date column only when po_date is set; its 15% goes to PO No / Reference otherwise --}}
            {{#if basicdetails.[0].po_date}}<col style="width:17%"><col style="width:15%"><col style="width:19%">{{else}}<col style="width:24%"><col style="width:27%">{{/if}}
        </colgroup>
        <tr>
            <th><span class="arab">تاريخ الفاتورة</span>Invoice Date</th>
            <th><span class="arab">فترة الفاتورة</span>Invoice Period</th>
            <th><span class="arab">تاريخ الاستحقاق</span>Invoice Due</th>
            <th><span class="arab">رقم عقد/أمر الشراء</span>Contract / PO No</th>
            {{#if basicdetails.[0].po_date}}<th><span class="arab">تاريخ عقد/أمر الشراء</span>Contract/ PO Date</th>{{/if}}
            <th><span class="arab">رقم المرجع أخر</span>Project Reference No</th>
        </tr>
        {{#with basicdetails.[0]}}
        <tr>
            <td>{{inv_date}}</td>
            <td>{{#if inv_from}}{{inv_from}} - {{inv_to}}{{/if}}</td>
            <td>{{due_date}}</td>
            <td>{{order_no}}</td>
            {{#if po_date}}<td>{{po_date}}</td>{{/if}}
            <td>{{reference_no}}</td>
        </tr>
        {{/with}}
    </table>

    {{!-- ── Our details — only when d570 is on ────────── --}}
    {{#ifFlag datasettings "d570"}}
    <table class="sec detail">
        <colgroup>
            <col style="width:10%"><col style="width:18%"><col style="width:7%">
            <col style="width:15%"><col style="width:13%"><col style="width:9%">
            <col style="width:18%"><col style="width:10%">
        </colgroup>
        <tr>
            <td class="sec_hd" colspan="8">■ Our Details<span class="rt arab">تفاصيلنا ■</span></td>
        </tr>
        <tr>
            <td class="ts bg-l">To</td>
            <td class="ts b" colspan="3">{{branch.[0].name}}</td>
            <td class="te arab" colspan="3" style="font-weight: 700;">{{branch_lang2.[0].name}}</td>
            <td class="te arab bg-l">الإسم</td>
        </tr>
        <tr>
            <td class="ts bg-l">Address</td>
            <td class="ts" colspan="3">{{joinAddress branch.[0] ', '}}</td>
            <td class="te arab" colspan="3">{{joinAddress branch_lang2.[0] '، '}}</td>
            <td class="te arab bg-l">العنوان</td>
        </tr>
        <tr>
            <td class="ts bg-l">VAT Reg. No</td>
            <td class="ts">{{branch.[0].vat}}</td>
            <td class="ts bg-l">CR No</td>
            <td class="ts">{{branch.[0].cr_no}}</td>
            <td class="te arab">{{branch_lang2.[0].cr_no}}</td>
            <td class="te arab bg-l">السجل التجاري</td>
            <td class="te arab">{{branch_lang2.[0].vat}}</td>
            <td class="te arab bg-l">الرقم الضريبي</td>
        </tr>
    </table>
    {{/ifFlag}}

    {{!-- ── Customer details ──────────────────────────── --}}
    <table class="sec detail">
        <colgroup>
            <col style="width:10%"><col style="width:18%"><col style="width:7%">
            <col style="width:15%"><col style="width:13%"><col style="width:9%">
            <col style="width:18%"><col style="width:10%">
        </colgroup>
        <tr>
            <td class="sec_hd" colspan="8">■ Customer Details<span class="rt arab">تفاصيل العميل ■</span></td>
        </tr>
        <tr>
            <td class="ts bg-l">To</td>
            <td class="ts b" colspan="3">{{billing_address.[0].name}}</td>
            <td class="te arab" colspan="3" style="font-weight: 700;">{{billing_address_lang2.[0].name}}</td>
            <td class="te arab bg-l">الإسم</td>
        </tr>
        <tr>
            <td class="ts bg-l">Address</td>
            <td class="ts" colspan="3">{{joinAddress billing_address.[0] ', '}}</td>
            <td class="te arab" colspan="3">{{joinAddress billing_address_lang2.[0] '، '}}</td>
            <td class="te arab bg-l">العنوان</td>
        </tr>
        <tr>
            <td class="ts bg-l">VAT Reg. No</td>
            <td class="ts">{{billing_address.[0].vat}}</td>
            <td class="ts bg-l">CR No</td>
            <td class="ts">{{customer_details.[0].cr_no}}</td>
            <td class="te arab">{{customer_details.[0].cr_no_lang2}}</td>
            <td class="te arab bg-l">السجل التجاري</td>
            <td class="te arab">{{billing_address_lang2.[0].vat}}</td>
            <td class="te arab bg-l">الرقم الضريبي</td>
        </tr>
    </table>

    {{!-- project line — plain row between the blocks, only when set --}}
    {{#if basicdetails.[0].project_name}}
    <div class="proj_line"><span class="b">Project :</span> {{basicdetails.[0].project_name}}</div>
    {{/if}}

    {{!-- ── Items ─────────────────────────────────────── --}}
    <table class="sec items" style="margin-top:5px;">
        <colgroup>
            <col style="width:3%"><col style="width:29%"><col style="width:6%">
            <col style="width:8%"><col style="width:10%"><col style="width:12%">
            <col style="width:8%"><col style="width:11%"><col style="width:13%">
        </colgroup>
        <thead>
            <tr>
                <th><span class="arab">م</span>#</th>
                <th><span class="arab">الوصف</span>Item Description</th>
                <th><span class="arab">الوحدة</span>Unit</th>
                <th><span class="arab">الكمية</span>Quantity</th>
                <th><span class="arab">سعر الوحدة</span>Unit Rate</th>
                <th><span class="arab">المبلغ (بدون ضريبة)</span>Amount</th>
                <th><span class="arab">نسبة ضريبة</span>VAT%</th>
                <th><span class="arab">مبلغ ضريبة</span>VAT Amount</th>
                <th><span class="arab">الإجمالي (شامل ضريبة)</span>Total Amount</th>
            </tr>
        </thead>
        <tbody>
            {{#each itemdetails}}
            <tr>
                <td class="tc">{{addOne @index}}</td>
                <td class="ts">
                    {{item_name}}
                    {{#if name_lang2}}<span class="sub arab" dir="rtl">{{name_lang2}}</span>{{/if}}
                    {{#if description}}<span class="sub">{{description}}</span>{{/if}}
                </td>
                <td class="tc">{{unit}}</td>
                <td class="tc">{{formatAmount quantity ../bcdp}}</td>
                <td class="te">{{{currencySymbol (default currency_isocode ../currency_isocode)}}} {{formatAmount price ../bcdp}}</td>
                <td class="te">{{{currencySymbol (default currency_isocode ../currency_isocode)}}} {{formatAmount taxable ../bcdp}}</td>
                <td class="tc">{{vat_perc}}%</td>
                <td class="te">{{{currencySymbol (default currency_isocode ../currency_isocode)}}} {{formatAmount vat_amt ../bcdp}}</td>
                <td class="te">{{{currencySymbol (default currency_isocode ../currency_isocode)}}} {{formatAmount amount ../bcdp}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    {{!-- ── QR + summary ──────────────────────────────── --}}
    <table class="foot_wrap">
        <tr>
            <td class="qr_cell">{{{qrDataUri qrCodeBase64}}}</td>
            <td>
                <table class="sec summary" style="margin-top:0;">
                    <colgroup>
                        <col style="width:40%"><col style="width:18%"><col style="width:42%">
                    </colgroup>
                    {{#with basicdetails.[0]}}
                    <tr>
                        <td class="ts">Grand Total Amount (Excl. VAT)</td>
                        <td class="amt">{{{currencySymbol ../currency_isocode}}} {{formatAmount (divide subtotal ../ccrate) ../bcdp}}</td>
                        <td class="ar arab">المبلغ الإجمالي (بدون ضريبة)</td>
                    </tr>
                    {{!-- Discount rows, three cases:
                         1. zatcadiscount present  -> one row per reason, then After Discount
                         2. otherwise discount/dld -> Total Discount (discount + dld), then After Discount
                         3. no discount at all     -> neither row is rendered --}}
                    {{#if ../zatcadiscount.[0]}}
                      {{#each ../zatcadiscount}}
                      <tr>
                        <td class="ts">{{#if reason_name}}{{reason_name}}{{else}}Total Discount{{/if}}</td>
                        <td class="amt">{{{currencySymbol ../../currency_isocode}}} {{formatAmount (divide dld ../../ccrate) ../../bcdp}}</td>
                        <td class="ar arab">{{#if reason_name_lang2}}{{reason_name_lang2}}{{else}}إجمالي مبلغ الخصم{{/if}}</td>
                      </tr>
                      {{/each}}
                      <tr>
                        <td class="ts">Total Amount After Discount</td>
                        <td class="amt">{{{currencySymbol ../currency_isocode}}} {{formatAmount (divide (subtract subtotal (sumProperty ../zatcadiscount 'dld')) ../ccrate) ../bcdp}}</td>
                        <td class="ar arab">المبلغ الإجمالي بعد الخصم</td>
                      </tr>
                    {{else}}
                      {{#if (gt (add discount dld) 0)}}
                      <tr>
                        <td class="ts">Total Discount</td>
                        <td class="amt">{{{currencySymbol ../currency_isocode}}} {{formatAmount (divide (add discount dld) ../ccrate) ../bcdp}}</td>
                        <td class="ar arab">إجمالي مبلغ الخصم</td>
                      </tr>
                      <tr>
                        <td class="ts">Total Amount After Discount</td>
                        <td class="amt">{{{currencySymbol ../currency_isocode}}} {{formatAmount (divide (subtract subtotal (add discount dld)) ../ccrate) ../bcdp}}</td>
                        <td class="ar arab">المبلغ الإجمالي بعد الخصم</td>
                      </tr>
                      {{/if}}
                    {{/if}}
                    {{!-- ZATCA charges, listed above the VAT line; nothing renders
                         when the array is absent or empty --}}
                    {{#if ../zatcacharge.[0]}}
                      {{#each ../zatcacharge}}
                      <tr>
                        <td class="ts">{{#if reason_name}}{{reason_name}}{{else}}Charges{{/if}}</td>
                        <td class="amt">{{{currencySymbol ../../currency_isocode}}} {{formatAmount (divide dld ../../ccrate) ../../bcdp}}</td>
                        <td class="ar arab">{{#if reason_name_lang2}}{{reason_name_lang2}}{{else}}الرسوم{{/if}}</td>
                      </tr>
                      {{/each}}
                    {{/if}}
                    <tr>
                        <td class="ts">Total VAT Amount</td>
                        <td class="amt">{{{currencySymbol ../currency_isocode}}} {{formatAmount (divide vatamt ../ccrate) ../bcdp}}</td>
                        <td class="ar arab">إجمالي مبلغ ضريبة القيمة المضافة</td>
                    </tr>
                    <tr>
                        <td class="ts">Grand Total Amount (Incl. VAT)</td>
                        <td class="amt">{{{currencySymbol ../currency_isocode}}} {{formatAmount (divide grand_total ../ccrate) ../bcdp}}</td>
                        <td class="ar arab">المبلغ الإجمالي (شامل ضريبة)</td>
                    </tr>
                    <tr>
                        <td class="ts">Net Due Amount</td>
                        <td class="amt">{{{currencySymbol ../currency_isocode}}} {{formatAmount (divide balance ../ccrate) ../bcdp}}</td>
                        <td class="ar arab">المبلغ المستحق الصافي</td>
                    </tr>
                    {{/with}}
                    <tr>
                        <td class="words" colspan="3">
                            <div class="lbl">Amount in words :</div>
                            {{#if bcamountinwordsar}}
                            <div class="ar_w arab" dir="rtl">{{bcamountinwordsar}} فقط</div>
                            {{/if}}
                            {{#if bcamountinwords}}
                            <div class="en_w">{{bcamountinwords}} Only</div>
                            {{/if}}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    {{!-- ── Bank details ──────────────────────────────── --}}
    <table class="sec bank">
        <colgroup>
            <col style="width:18%"><col style="width:40%"><col style="width:21%">
            <col style="width:21%">
        </colgroup>
        <tr>
            <th colspan="2">Bank Details / <span class="arab">التفاصيل المصرفية</span></th>
            <th>Approved By / <span class="arab">تمت الموافقة</span></th>
            <th>Recieved By / <span class="arab">فاتورة مستالم</span></th>
        </tr>
        <tr>
            <td class="ts">Bank Name / <span class="arab">اسم الحساب</span></td>
            <td class="ts bval">{{bankdetails.name}}{{#if bankdetails_lang2.name}} / <span class="arab">{{bankdetails_lang2.name}}</span>{{/if}}</td>
            <td class="sig" rowspan="5">
                {{!-- d165 prints the signature here; if that is off, d146 puts
                     the seal in the same cell instead --}}
                {{#ifFlag datasettings "d165"}}<img class="Signature" src="{{Signature}}" alt="Signature" style="max-height:min({{default datasettings.d459 '120'}}px,100%); max-width:min({{default datasettings.d459 '120'}}px,100%);" onerror="this.style.display='none'"/>{{else}}{{#ifFlag datasettings "d146"}}<img class="Seal" src="{{Seal}}" alt="Seal" style="max-height:min({{default datasettings.d458 '120'}}px,100%); max-width:min({{default datasettings.d458 '120'}}px,100%);" onerror="this.style.display='none'"/>{{/ifFlag}}{{/ifFlag}}
            </td>
            <td class="sig" rowspan="5"></td>
        </tr>
        <tr>
            <td class="ts">Bank / <span class="arab">بنك</span></td>
            <td class="ts bval">{{bankdetails.acc_name}}{{#if bankdetails_lang2.acc_name}} / <span class="arab">{{bankdetails_lang2.acc_name}}</span>{{/if}}</td>
        </tr>
        <tr>
            <td class="ts">Account No. / <span class="arab">رقم الحساب</span></td>
            <td class="ts bval">{{bankdetails.acc_no}}{{#if bankdetails_lang2.acc_no}} / <span class="arab">{{bankdetails_lang2.acc_no}}</span>{{/if}}</td>
        </tr>
        <tr>
            <td class="ts">IBAN / <span class="arab">آيبان</span></td>
            <td class="ts bval">{{bankdetails.iban_no}}{{#if bankdetails_lang2.iban_no}} / <span class="arab">{{bankdetails_lang2.iban_no}}</span>{{/if}}</td>
        </tr>
        <tr>
            <td class="ts">Swift Code / <span class="arab">رمز السرعة</span></td>
            <td class="ts bval">{{bankdetails.swift_no}}{{#if bankdetails_lang2.swift_no}} / <span class="arab">{{bankdetails_lang2.swift_no}}</span>{{/if}}</td>
        </tr>
        <tr>
            <td class="ts">Branch / <span class="arab">فرع</span></td>
            <td class="ts bval">{{bankdetails.branch_name}}{{#if bankdetails_lang2.branch_name}} / <span class="arab">{{bankdetails_lang2.branch_name}}</span>{{/if}}</td>
            <td class="sig_lbl"><span class="arab">التوقيع مع الختم</span><br>Signature with Stamp</td>
            <td class="sig_lbl"><span class="arab">التوقيع مع الختم</span><br>Signature with Stamp</td>
        </tr>
    </table>

</body>
</html>
