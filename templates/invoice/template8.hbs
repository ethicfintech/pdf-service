<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Invoice - {{basicdetails.[0].inv_no}}</title>
<style>

*{
    margin:0;
    box-sizing:border-box;
}

body{
    font-family: ibmplexsansarabic;
    font-size:9px;
    color:#000;
    margin:0 8mm;
}

table{
    width:100%;
    border-collapse:collapse;
}

td,th{
    border:1px solid #6b6b6b;
    padding:2px 4px;
    vertical-align:middle;
}

.title-bar{
    text-align:center;
    font-size:20px;
    font-weight:bold;
    {{!-- padding:6px 0; --}}
}

.section-title{
    background:#f2f2f2;
    font-weight:bold;
}

.label-ar{
    direction:rtl;
    text-align:right;
}

.center{ text-align:center; }
.right{ text-align:right; }
.bold{ font-weight:bold; }

.items-head{
    background:#f2f2f2;
    font-weight:bold;
    text-align:center;
}

</style>
</head>
<body>

<!-- Title -->

<div class="title-bar">
TAX INVOICE / الفاتورة الضريبية
</div>


<!-- From / Supplier -->

<table style="border-collapse:collapse;width:100%;font-size:10px;">
    <tr>
      <td colspan="8" class="section-title">
          <table style="width:100%;border:none;">
              <tr style="font-size:10px;">
                  <td style="border:none;padding:0;">Invoice Number : {{basicdetails.[0].inv_no}}</td>
                  <td style="border:none;padding:0;direction:rtl;text-align:right;"> رقم الفاتورة : {{basicdetails.[0].inv_no_arabic}}</td>
              </tr>
          </table>
      </td>
    </tr>
    <tr>
        <td colspan="8" class="section-title">
            <table style="width:100%;border:none;">
                <tr style="font-size:10px;">
                    <td style="border:none;padding:0;">Our Details</td>
                    <td style="border:none;padding:0;direction:rtl;text-align:right;">تفاصيل شركتنا</td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td width="10%">Name</td>
        <td width="39%" colspan="3">{{branch.[0].name}}</td>
        <td width="39%" colspan="3" class="label-ar">{{branch_lang2.[0].name}}</td>
        <td width="10%" class="label-ar" colspan="3">الاسم</td>
    </tr>
    <tr>
        <td>Building No</td>
        <td colspan="3">{{branch.[0].address_line1}}</td>
        <td colspan="3" class="label-ar">{{branch_lang2.[0].address_line1}}</td>
        <td class="label-ar" colspan="3">رقم المبنى</td>
    </tr>
    <tr>
        <td>Street Name</td>
        <td colspan="3">{{branch.[0].address_line2}}</td>
        <td colspan="3" class="label-ar">{{branch_lang2.[0].address_line2}}</td>
        <td class="label-ar" colspan="3">اسم الشارع</td>
    </tr>
    <tr>
        <td width="10%">District</td>
        <td width="15%">{{branch.[0].address_line3}}</td>
        <td width="9%">City</td>
        <td width="15%">{{branch.[0].address_line4}}</td>
        <td width="15%" class="label-ar">{{branch_lang2.[0].address_line3}}</td>
        <td width="9%" class="label-ar">المدينة</td>
        <td width="15%" class="label-ar">{{branch_lang2.[0].additional_no}}</td>
        <td width="10%" class="label-ar"> الحي</td>
    </tr>
    <tr>
        <td>Country</td>
        <td>{{branch.[0].address_line5}}</td>
        <td>Postal Code</td>
        <td>{{branch.[0].address_code}}</td>
        <td class="label-ar">{{branch_lang2.[0].address_line5}}</td>
        <td class="label-ar">الرمز البريدي</td>
        <td class="label-ar">{{branch_lang2.[0].address_code}}</td>
        <td class="label-ar">البلد</td>
    </tr>
    <tr>
        <td>VAT Number</td>
        <td>{{branch.[0].vat}}</td>
        <td>CRN</td>
        <td>{{branch.[0].cr_no}}</td>
        <td class="label-ar">{{branch_lang2.[0].cr_no}}</td>
        <td class="label-ar"> سجل التجاري</td>
        <td class="label-ar">{{branch_lang2.[0].vat}}</td>
        <td class="label-ar">الرقم الضريبي</td>
    </tr>
</table>


<!-- Client Details -->


<table style="border-collapse:collapse;width:100%;margin-top:4px;font-size:10px;">
    <tr>
        <td colspan="8" class="section-title">
            <table style="width:100%;border:none;">
                <tr style="font-size:10px;">
                    <td style="border:none;padding:0;">Client Details</td>
                    <td style="border:none;padding:0;direction:rtl;text-align:right;">تفاصيل العميل </td>
                </tr>
            </table>
        </td>
    </tr>
    <tr>
        <td width="10%">Name</td>
        <td width="39%" colspan="3">{{billing_address.[0].name}}</td>
        <td width="39%" colspan="3" class="label-ar">{{billing_address_lang2.[0].name}}</td>
        <td width="10%" class="label-ar" colspan="3">الاسم</td>
    </tr>
    <tr>
        <td width="10%">Building No</td>
        <td width="39%" colspan="3">{{billing_address.[0].address_line1}}</td>
        <td width="39%" colspan="3" class="label-ar">{{billing_address_lang2.[0].address_line1}}</td>
        <td width="10%" class="label-ar" colspan="3">رقم المبنى</td>
    </tr>
    <tr>
        <td>Street Name</td>
        <td colspan="3">{{billing_address.[0].address_line2}}</td>
        <td colspan="3" class="label-ar">{{billing_address_lang2.[0].address_line2}}</td>
        <td class="label-ar" colspan="3">اسم الشارع</td>
    </tr>
    <tr>
        <td width="10%">District</td>
        <td width="15%">{{billing_address.[0].address_line3}}</td>
        <td width="9%">City</td>
        <td width="15%">{{billing_address.[0].address_line4}}</td>
        <td width="15%" class="label-ar">{{billing_address_lang2.[0].address_line4}}</td>
        <td width="9%" class="label-ar">المدينة</td>
        <td width="15%" class="label-ar">{{billing_address_lang2.[0].address_line3}}</td>
        <td width="10%" class="label-ar"> الحي</td>
    </tr>
    <tr>
        <td>Country</td>
        <td>{{billing_address.[0].address_line5}}</td>
        <td>Postal Code</td>
        <td>{{billing_address.[0].address_code}}</td>
        <td class="label-ar">{{billing_address_lang2.[0].address_code}}</td>
        <td class="label-ar">الرمز البريدي</td>
        <td class="label-ar">{{billing_address_lang2.[0].address_line5}}</td>
        <td class="label-ar">البلد</td>
    </tr>
    <tr>
        <td>VAT Number</td>
        <td>{{billing_address.[0].vat}}</td>
        <td>CRN</td>
        <td>{{customer_details.[0].cr_no}}</td>
        <td class="label-ar">{{customer_details.[0].cr_no_lang2}}</td>
        <td class="label-ar"> سجل التجاري</td>
        <td class="label-ar">{{billing_address_lang2.[0].vat}}</td>
        <td class="label-ar">الرقم الضريبي</td>
    </tr>
</table>


<!-- Invoice meta row -->

<table style="border-collapse:collapse;width:100%;margin-top:4px;font-size:9px;font-weight:bold;">
    <tr style="text-align: center;">
        <td width="14%">
            <div>Invoice Date</div>
            <div>تاريخ الفاتورة</div>
        </td>
        <td width="14%">
            <div>Supply Date</div>
            <div> تاريخ العرض </div>
        </td>
        <td width="21%">
            <div>Contract/ PO No</div>
            <div>رقم طلب الشراء</div>
        </td>
        <td width="14%">
            <div>Due Date</div>          
            <div>تاريخ الاستحقاق</div>
        </td>
        <td width="18%">
            <div>Invoice Period</div>
            <div>فترة الفاتورة</div>
        </td>
        <td width="19%">
            <div>Project Name</div>
            <div>اسم المشروع</div>
        </td>
    </tr>
    <tr style="text-align: center;">
        <td>{{basicdetails.[0].inv_date}}</td>
        <td>{{basicdetails.[0].sup_date}}</td>
        <td>{{basicdetails.[0].order_no}}</td>
        <td>{{basicdetails.[0].due_date}}</td>
        <td><span class="my-fmt">{{basicdetails.[0].inv_from}}</span></td>
        <td>{{basicdetails.[0].project_name}}</td>
    </tr>
</table>

<script>
  // inv_from like "02-Mar-2026" -> "Mar-2026" (month-year only)
  document.querySelectorAll('.my-fmt').forEach(function (el) {
    var m = el.textContent.trim().match(/^\d{1,2}[-\/ ]([A-Za-z]{3})[A-Za-z]*[-\/ ](\d{4})$/);
    if (m) el.textContent = m[1] + '-' + m[2];
  });
</script>


<!-- Items Table (RTL order in cells) -->

<table style="border-collapse:collapse;width:100%;margin-top:4px;">
    <thead>
        <tr class="items-head" style="font-size:9px;">
            <th width="12">
                <div>Item Subtotal</div>
                <div class="label-ar" style="text-align: center;">المجموع </div>
            </th>
            <th width="11%">
                <div>{{datasettingstextvalue.d828}}</div>
                <div class="label-ar" style="text-align: center;">معدل الضريبة</div>
            </th>
            <th width="8%">
                <div>TAX Rate</div>
                <div class="label-ar" style="text-align: center;">الضريبة</div>
            </th>
            <th width="11%">
                <div>Taxable Amount</div>
                <div class="label-ar" style="text-align: center;"> الإجمالي</div>
            </th>
            <th width="7">
                <div>QTY</div>
                <div class="label-ar" style="text-align: center;">الكمية</div>
            </th>
            <th width="10%">
                <div>Rate</div>
                <div class="label-ar" style="text-align: center;">المعدل</div>
            </th>
            <th width="28%">
                <div>Description</div>
                <div class="label-ar" style="text-align: center;">الوصف</div>
            </th>
            <th width="10%">
                <div>Code (SKU)</div>
                <div class="label-ar" style="text-align: center;">رمز الصنف</div>
            </th>
            <th width="3">
                <div>#</div>
                <div class="label-ar" style="text-align: center;">م</div>
            </th>
        </tr>
    </thead>
    <tbody>
        {{#each itemdetails}}
        <tr>
          <td class="right"><span style="font-size: 12px;">{{currencySymbol basicdetails.[0].currency_isocode}}</span> {{formatAmount amount ../bcdp}}</td>
          <td class="right"><span style="font-size: 12px;">{{currencySymbol basicdetails.[0].currency_isocode}}</span> {{formatAmount tax ../bcdp}}</td>
          <td class="center">{{vat_perc}}</td>
          <td class="right"><span style="font-size: 12px;">{{currencySymbol basicdetails.[0].currency_isocode}}</span> {{formatAmount taxable ../bcdp}}</td>
          <td class="center">{{quantity}}</td>
          <td class="right"><span style="font-size: 12px;">{{currencySymbol basicdetails.[0].currency_isocode}}</span> {{formatAmount price ../bcdp}}</td>
          <td>
              {{item_name}}
                  {{#if name_lang2}}<div>{{name_lang2}}</div>{{/if}}
                  {{#if description}}<div>{{description}}</div>{{/if}}
          </td>
          <td class="center">{{item_code}}</td>
          <td class="center">{{addOne @index}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>


<!-- Totals (vertical breakdown) + QR -->
<table style="border-collapse:collapse;width:100%;margin-top:4px;font-size:10px;">
    <tr>
        <td width="25%">
            <div>Total Amount (Excluding VAT)</div>
        </td>
        <td width="30%">
            <div class="right">المبلغ الإجمالي (باستثناء ضريبة القيمة المضافة)</div>
        </td>
        <td width="20" class="right"><span style="font-size: 15px;">{{currencySymbol basicdetails.[0].currency_isocode}}</span> {{formatAmount basicdetails.[0].subtotal bcdp}}</td>
        <td width="20%" rowspan="4" style="text-align:center;vertical-align:middle;">{{{qrDataUri qrCodeBase64}}}</td>
    </tr>
    <tr>
        <td>
            <div>Total VAT Amount</div>
        </td>
        <td width="30%">
            <div class="right">إجمالي ضريبة القيمة المضافة</div>
        </td>
        <td class="right"><span style="font-size: 15px;">{{currencySymbol basicdetails.[0].currency_isocode}}</span> {{formatAmount basicdetails.[0].vatamt bcdp}}</td>
    </tr>
    <tr>
        <td>
            <div>Total Amount(Incl VAT)</div>
        </td>
        <td width="30%">
            <div class="right">المبلغ الإجمالي (شامل ضريبة القيمة المضافة)</div>
        </td>
        <td class="right"><span style="font-size: 15px;">{{currencySymbol basicdetails.[0].currency_isocode}}</span> {{formatAmount basicdetails.[0].grand_total bcdp}}</td>
    </tr>
    <tr>
        <td class="bold">
            <div>Total Payable</div>
        </td>
        <td width="30%">
            <div class="right bold">مجموع المستحق الدفع</div>
        </td>
        <td class="right bold"><span style="font-size: 15px;">{{currencySymbol basicdetails.[0].currency_isocode}}</span> {{formatAmount basicdetails.[0].balance bcdp}}</td>
    </tr>
</table>


<!-- Amount in Words -->
<table style="border-collapse:collapse;width:100%;margin-top:4px;font-size:9px;">
    <tr>
        <td style="width: 55%;">Total Payable : {{bcamountinwords}}</td>
        <td style="width: 45%;text-align:right;"> مجموع المستحق الدفع : {{bcamountinwordsar}}</td>
    </tr>
    <tr>
        <td colspan="2">VAT : {{vatamountinwords}} </td>
    </tr>
</table>


<!-- Bank Details + Signatures -->

<div style="display:block;page-break-inside:avoid;break-inside:avoid;margin-top:6px;">
<table style="border-collapse:collapse;width:100%;page-break-inside:avoid;break-inside:avoid;">
        <tr class="section-title" style="text-align:center;">
            <th colspan="2">
                <table style="width:100%;border:none;">
                    <tr>
                        <td style="border:none;padding:0;text-align:center;font-weight:bold;font-size:9px;">Bank Details / <span>التفاصيل المصرفية</span></td>
                    </tr>
                </table>
            </th>
            <th style="font-size: 9px;">Prepared By / <span>أُعدت بواسطة</span></th>
            <th style="font-size: 9px;">Recieved By / <span>استلمت من قبل</span></th>
            <th style="font-size: 9px;">Approved By / <span>اعتمدت من قبل</span></th>
        </tr>
        <tr>
            <td width="16.8%" style="padding: 5px 2px;">
                <div>Account Name <span class="label-ar">/ إسم الحساب</span></div>
            </td>
            <td width="29.2%" style="padding: 5px 2px;">{{bankdetails.acc_name}}</td>
           <td width="18%" rowspan="5" style="vertical-align:bottom;text-align:center;padding-bottom:6px;height:90px;">
            <div style="">{{#ifFlag datasettings "d165"}}<img class="seal-img" src="{{Signature}}" alt="Signature" style="max-height:{{datasettings.d459}}px; max-width:{{datasettings.d459}}px;" onerror="this.style.display='none'"/>{{else}}<div style="height:60px;"></div>{{/ifFlag}}</div>
                <div>Signature with Stamp</div>
            </td>
            <td width="18%" rowspan="5" style="vertical-align:bottom;text-align:center;padding-bottom:6px;height:90px;">
                <div style="height:60px;"></div>
                <div>Signature with Stamp</div>
            </td>
            <td width="18%" rowspan="5" style="vertical-align:bottom;text-align:center;padding-bottom:6px;height:90px;">
                <div style="">{{#ifFlag datasettings "d146"}}<img class="seal-img" src="{{Seal}}" alt="Seal" style="max-height:{{datasettings.d458}}px; max-width:{{datasettings.d458}}px;" onerror="this.style.display='none'"/>{{/ifFlag}}</div>
                <div>Signature with Stamp</div>
            </td>
        </tr>
        <tr>
            <td style="padding: 5px 2px;">
                <div>Bank Name <span class="label-ar">/ اسم البنك</span></div>
            </td>
            <td style="padding: 5px 2px;">{{bankdetails.name}}</td>
        </tr>
        <tr>
            <td style="padding: 5px 2px;">
                <div>Account Number <span class="label-ar">/ رقم حساب</span></div>
            </td>
            <td style="padding: 5px 2px;">{{bankdetails.acc_no}}</td>
        </tr>
        <tr>
            <td style="padding: 5px 2px;">
                <div>IBAN No <span class="label-ar">/ رقم الآيبان</span></div>
            </td>
            <td style="padding: 5px 2px;">{{bankdetails.iban_no}}</td>
        </tr>
        <tr>
            <td style="padding: 5px 2px;">
                <div>SWIFT No <span class="label-ar">/ رقم سريع</span></div>
            </td>
            <td style="padding: 5px 2px;">{{bankdetails.swift_no}}</td>
        </tr>
</table>
</div>

</body>
</html>
