<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QUOTATION - {{basicdetails.[0].inv_no}}</title>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #ffffff;
    font-family: ibmplexsansarabic;
    font-size: 11px;
    color: #222;
    line-height: 1.45;
    margin: 0 8mm;
  }

  .page { width: 100%; margin: 0 auto; padding-top: 6px; }

  /* ── Title ─────────────────────────────────── */
  .main-title {
    text-align: center;
    font-family: ibmplexsansarabic;
    font-size: 26px;
    font-weight: bold;
    color: #1f3a6b;
    padding: 4px 0 16px;
    letter-spacing: 1px;
  }

  /* ── Outer doc table ───────────────────────── */
  .doc-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    border: 2px solid #000;
  }
  .doc-table > tbody > tr > td {
    border: 1px solid #ccc;
    padding: 0;
    vertical-align: top;
    font-size: 11px;
  }

  /* ── Top header row ────────────────────────── */
  .top-head {
    text-align: center;
    padding: 10px;
    font-size: 12px;
  }

  .ref-head-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .ref-head-table td {
    padding: 6px 8px;
    font-size: 11px;
    text-align: center;
  }
  .ref-head-table .v-sep { border-right: 1px solid #000; }
  .ref-head-table .ref-hdr { font-weight: normal; }
  .ref-head-table .ref-val { font-weight: bold; }

  /* ── Address / quotation block ─────────────── */
  .addr-cell {
    padding: 8px 8px;
    vertical-align: top;
    min-height: 130px;
    font-size: 9px;
  }
  .addr-line { line-height: 1.55; }

  .qno-cell {
    padding: 62px 10px 10px;
    text-align: center;
    vertical-align: middle;
    font-size: 14px;
  }
  .qno-val { font-weight: bold; font-size: 14px; }

  /* ── Items table ───────────────────────────── */
  .items-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .items-table th,
  .items-table td {
    font-size: 11px;
    vertical-align: top;
    padding: 8px 6px;
    border: 1px solid #ccc;
  }
  .items-table thead th {
    text-align: center;
    vertical-align: middle;
    font-weight: bold;
    background: #0d1676;
    color: #ffffff;
    border: 1px solid #1f3a6b;
  }
  .items-table tbody td { height: 57px; }
  .items-table .center { text-align: center; }
  .items-table .right  { text-align: right; }
  .items-table .left   { text-align: left; }

  /* ── Remark row ────────────────────────────── */
  .remark-cell { padding: 6px 10px; font-size: 11px; min-height: 20px; }

  /* ── Bottom combined section ───────────────── */
  .bottom-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .bottom-table > tbody > tr > td {
    padding: 0;
    vertical-align: top;
    font-size: 11px;
  }

  .words-block { padding: 8px 10px; }
  .words-value { font-weight: bold; margin-top: 2px; }

  .totals-table {
    width: 100%;
    border-collapse: collapse;
  }
  .totals-table td {
    padding: 8px 10px;
    font-size: 13px;
    border-bottom: 1px solid #ccc;
  }
  .totals-table .t-lbl { text-align: right; border-right: 1px solid #ccc; }
  .totals-table .t-val { text-align: right; width: 35%; }

  .signoff-cell {
    padding: 8px 10px;
    text-align: right;
    font-size: 13px;
  }

  {{#if UseBGWatermark}}
  {{#if WatermarkCss}}
  body::after {
    content: "";
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-image: url('{{{WatermarkCss}}}');
    background-repeat: no-repeat;
    background-position: center center;
    background-size: 100% auto;
    opacity: 0.7;
    pointer-events: none;
    z-index: -1;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  {{/if}}
  {{/if}}
</style>
</head>
<body>

<div class="page">

  <!-- Title -->
  <div class="main-title">QUOTATION</div>

  <!-- Document -->
  <table class="doc-table">
    <!-- Header bar: customer name | reference + date -->
    <tr>
      <td style="width:50%; padding:10px;" class="top-head">
        {{billing_address.[0].name}}
      </td>
      <td style="width:50%; padding:0;">
        <table class="ref-head-table">
          <tr>
            <td class="v-sep ref-hdr">Reference No<br><span class="ref-val">{{basicdetails.[0].reference_no}}</span></td>
            <td class="ref-hdr">Date<br><span class="ref-val">{{basicdetails.[0].inv_date}}</span></td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- Address + Quotation No -->
    <tr>
      <td style="padding:0;">
        <div class="addr-cell">
          {{#if billing_address.[0].address_line1}}<div class="addr-line">{{billing_address.[0].address_line1}}</div>{{/if}}
          {{#if billing_address.[0].address_line2}}<div class="addr-line">{{billing_address.[0].address_line2}}</div>{{/if}}
          {{#if billing_address.[0].address_line3}}<div class="addr-line">{{billing_address.[0].address_line3}}</div>{{/if}}
          {{#if billing_address.[0].address_line4}}<div class="addr-line">{{billing_address.[0].address_line4}}</div>{{/if}}
          {{#if billing_address.[0].address_line5}}<div class="addr-line">{{billing_address.[0].address_line5}}</div>{{/if}}
          {{#if billing_address.[0].address_code}}<div class="addr-line">{{billing_address.[0].address_code}}</div>{{/if}}
          {{#if billing_address.[0].vat}}<div class="addr-line">{{billing_address.[0].vat}}</div>{{/if}}
        </div>
      </td>
      <td style="padding:0;">
        <div class="qno-cell">
          QUOTATION NO :<span class="qno-val">{{basicdetails.[0].inv_no}}</span>
        </div>
      </td>
    </tr>

    <!-- Items -->
    <tr>
      <td colspan="2" style="padding:0; border-top:1px solid #000;">
        <table class="items-table">
          <colgroup>
            <col style="width:5%">
            <col style="width:21%">
            <col style="width:9%">
            <col style="width:9%">
            <col style="width:11%">
            <col style="width:11%">
            <col style="width:11%">
            <col style="width:11%">
            <col style="width:12%">
          </colgroup>
          <thead>
            <tr>
              <th>#</th>
              <th>DESCRIPTION</th>
              <th>QTY</th>
              <th>UOM</th>
              <th>UNIT PRICE</th>
              <th>SUBTOTAL</th>
              <th>VAT</th>
              <th>{{#if itemdetails.[0].vat_perc}}{{itemdetails.[0].vat_perc}}%{{/if}}</th>
              <th>TOTAL</th>
            </tr>
          </thead>
          <tbody>
            {{#each itemdetails}}
            <tr>
              <td class="center">{{addOne @index}}</td>
              <td class="left">
                {{item_name}}
                {{#if name_lang2}}<div>{{name_lang2}}</div>{{/if}}
                {{#if description}}<div>{{description}}</div>{{/if}}
              </td>
              <td class="center">{{formatAmount quantity ../bcdp}}</td>
              <td class="center">{{unit}}</td>
              <td class="right"><span style="font-size:14px;">{{currencySymbol ../basicdetails.[0].base_country_isocode}}</span>{{formatAmount price ../bcdp}}</td>
              <td class="right"><span style="font-size:14px;">{{currencySymbol ../basicdetails.[0].base_country_isocode}}</span>{{formatAmount taxable ../bcdp}}</td>
              <td class="center">{{vat_perc}}</td>
              <td class="right"><span style="font-size:14px;">{{currencySymbol ../basicdetails.[0].base_country_isocode}}</span>{{formatAmount vat_amt ../bcdp}}</td>
              <td class="right"><span style="font-size:14px;">{{currencySymbol ../basicdetails.[0].base_country_isocode}}</span>{{formatAmount amount ../bcdp}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </td>
    </tr>

    <!-- Remark row -->
    <tr>
      <td colspan="2">
        <div class="remark-cell">
          {{#if basicdetails.[0].terms_and_condition}}{{{nl2br basicdetails.[0].terms_and_condition}}}{{else}}{{#if invterms}}{{{nl2br invterms}}}{{/if}}{{/if}}
        </div>
      </td>
    </tr>

    <!-- Words + Totals -->
    <tr>
      <td colspan="2" style="padding:0;">
        <table class="bottom-table">
          <tr>
            <td style="width:50%; padding:0; vertical-align:top; border:none;">
              <div class="words-block">
                <div>Amount chargable in words:</div>
                <div class="words-value">{{bcamountinwords}}</div>
              </div>
            </td>
            <td style="width:50%; padding:0; vertical-align:top;">
              <table class="totals-table">
                <tr>
                  <td class="t-lbl">Total Taxable Amount<br>(Excluding VAT)</td>
                  <td class="t-val"><span style="font-size:14px;">{{currencySymbol basicdetails.[0].base_country_isocode}}</span>{{formatAmount (divide basicdetails.[0].subtotal ccrate) bcdp}}</td>
                </tr>
                <tr>
                  <td class="t-lbl">Discount</td>
                  <td class="t-val"><span style="font-size:14px;">{{currencySymbol basicdetails.[0].base_country_isocode}}</span>{{formatAmount (divide basicdetails.[0].discount ccrate) bcdp}}</td>
                </tr>
                <tr>
                  <td class="t-lbl">After Discount</td>
                  <td class="t-val"><span style="font-size:14px;">{{currencySymbol basicdetails.[0].base_country_isocode}}</span>{{formatAmount (subtract (divide basicdetails.[0].subtotal ccrate) (divide basicdetails.[0].discount ccrate)) bcdp}}</td>
                </tr>
                <tr>
                  <td class="t-lbl">Total Amount</td>
                  <td class="t-val"><span style="font-size:14px;">{{currencySymbol basicdetails.[0].base_country_isocode}}</span>{{formatAmount (divide basicdetails.[0].grand_total ccrate) bcdp}}</td>
                </tr>
              </table>
              <div class="signoff-cell">
                For {{#if compprof.name}}{{compprof.name}}{{else}}{{basicdetails.[0].branchname}}{{/if}}
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

</div>

</body>
</html>
