<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quotation</title>

    <style>

        body {
            font-family: ibmplexsansarabic;
            font-size: 10px;
            color: #000;
            background: #fff;
            margin: 0 8mm;
        }

        .invoice-container {
            width: 100%;
            padding-top: 4px;
            background: white;
        }

        .header-title {
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            padding: 4px 0;
            border-bottom: 2px solid #ccc;
            margin-bottom: 0;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 3px;
        }

        .info-table td {
            padding: 2px 4px;
            border: 1px solid #ccc;
            font-size: 11px;
        }

        .info-table td.label {
            font-weight: bold;
            background-color: #f8f9fa;
        }

        .section-header {
            background-color: #000;
            color: #fff;
            padding: 3px 6px;
            font-weight: bold;
            font-size: 11px;
            margin-top: 3px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 3px;
        }

        .items-table th {
            background-color: #f8f9fa;
            border: 1px solid #ccc;
            padding: 3px 2px;
            font-size: 10px;
            font-weight: bold;
            text-align: center;
            line-height: 1.2;
        }

        .items-table td {
            border: 1px solid #ccc;
            padding: 3px 4px;
            font-size: 10px;
            vertical-align: top;
            line-height: 1.3;
        }

        .items-table td.center { text-align: center; }
        .cur { text-align: right; white-space: nowrap; }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
        }

        .summary-table td {
            padding: 3px 6px;
            font-size: 10px;
            border: 1px solid #ccc;
        }

        .summary-table td.lbl {
            font-weight: bold;
            background-color: #f8f9fa;
            width: 48%;
        }

        .summary-table td.val {
            text-align: right;
            width: 22%;
            white-space: nowrap;
        }

        .summary-table td.ar {
            text-align: right;
            background-color: #f8f9fa;
            font-weight: bold;
            font-family: ibmplexsansarabic;
            direction: rtl;
        }

        .summary-table tr.net-due td {
            background-color: #e9ecef;
            font-weight: bold;
        }

        .amount-words {
            text-align: center;
            padding: 4px 6px;
            font-weight: bold;
            font-size: 10px;
            border: 1px solid #ccc;
            margin-top: 2px;
            line-height: 1.5;
        }

        .qr-wrapper {
            width: 140px;
            height: 140px;
            border: 1px solid #ccc;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 4px;
            background: #fff;
        }

        .bank-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 5px;
        }

        .bank-table th {
            background-color: #f8f9fa;
            border: 1px solid #ccc;
            padding: 3px 4px;
            font-weight: bold;
            font-size: 11px;
            text-align: center;
        }

        .bank-table td {
            border: 1px solid #ccc;
            padding: 3px 6px;
            font-size: 10px;
            vertical-align: middle;
        }

        .bank-table td.blbl {
            font-weight: bold;
            background-color: #f8f9fa;
            width: 25%;
        }

        .signature-cell {
            height: 70px;
            text-align: center;
            vertical-align: bottom;
            font-size: 10px;
            font-weight: bold;
        }

        .sig-img {
            max-width: 80px;
            max-height: 55px;
            display: block;
            margin: 0 auto 4px;
        }

        .rtl {
            font-family: ibmplexsansarabic;
            direction: rtl;
            text-align: right;
        }
            .cust-table { margin-top: 3px; }
        .cust-table td { padding: 8px 10px; font-size: 11px; line-height: 1.3; vertical-align: middle; }
            .meta-table { margin-bottom: 0; }
        .meta-table td { text-align: center; vertical-align: middle; padding: 6px 4px; font-size: 11px; border: 1px solid #777; background: #fff; }
        .meta-table tr:nth-child(2) td { height: 34px; }
    </style>
</head>
<body>
<div class="invoice-container">

    <div class="header-title" style="font-size:22px; padding:2px 0 6px; border-bottom:1px solid #555; margin-bottom:12px;">QUOTATION / عرض سعر</div>

    {{#with basicdetails.[0]}}
    <table style="width:100%; border-collapse:collapse; margin-bottom:6px;">
        <tr>
            <td style="width:50%; font-weight:bold; font-size:13px; padding:2px 0;">■ Quotation No:&nbsp; {{inv_no}}</td>
            <td class="rtl" style="width:50%; font-weight:bold; font-size:13px; padding:2px 0;">■رقم عرض السعر:</td>
        </tr>
    </table>
    <table class="info-table meta-table">
        <tr>
            <td style="width:25%;"><span class="rtl">تاريخ عرض السعر</span><br><b>Quotation Date</b></td>
            <td style="width:32%;"><span class="rtl">عناية</span><br><b>Scope Of Work</b></td>
            <td style="width:43%;"><span class="rtl">رقم المرجع آخر</span><br><b>Location</b></td>
        </tr>
        <tr>
            <td>{{inv_date}}</td>
            <td>{{attention}}</td>
            <td>{{location}}</td>
        </tr>
    </table>
    <div style="margin:10px 0 6px; padding-left:6px; font-size:11px;"><b style="color:#4a5568;">Subject</b><span style="color:#4a5568;">:</span> {{subj}}</div>
    {{/with}}

    <table class="info-table cust-table">
        <colgroup><col style="width:10%"><col style="width:17%"><col style="width:7%"><col style="width:16%"><col style="width:16%"><col style="width:9%"><col style="width:15%"><col style="width:10%"></colgroup>
        <tr class="sec-row">
            <td colspan="4" style="font-weight:bold;">■ Customer Details</td>
            <td colspan="4" class="rtl" style="font-weight:bold;">تفاصيل العميل ■</td>
        </tr>
    {{#with billing_address.[0]}}
        <tr>
            <td>To</td>
            <td colspan="3" style="font-weight:bold;">{{name}}</td>
            <td colspan="3" class="rtl" style="font-weight:bold;">{{../billing_address_lang2.[0].name}}</td>
            <td class="rtl">الإسم</td>
        </tr>
        <tr>
            <td>Address</td>
            <td colspan="3">{{#if address_line1}}{{address_line1}} {{/if}}{{#if address_line2}}{{address_line2}} {{/if}}{{#if address_line3}}{{address_line3}} {{/if}}{{#if address_line4}}{{address_line4}} {{/if}}{{#if address_line5}}{{address_line5}} {{/if}}</td>
            <td colspan="3" class="rtl">{{#if ../billing_address_lang2.[0].address_line1}}{{../billing_address_lang2.[0].address_line1}} {{/if}}{{#if ../billing_address_lang2.[0].address_line2}}{{../billing_address_lang2.[0].address_line2}} {{/if}}{{#if ../billing_address_lang2.[0].address_line3}}{{../billing_address_lang2.[0].address_line3}} {{/if}}{{#if ../billing_address_lang2.[0].address_line4}}{{../billing_address_lang2.[0].address_line4}} {{/if}}{{#if ../billing_address_lang2.[0].address_line5}}{{../billing_address_lang2.[0].address_line5}} {{/if}}</td>
            <td class="rtl">العنوان</td>
        </tr>
        <tr>
            <td>VAT Reg. No</td>
            <td>{{vat}}</td>
            <td>CR No</td>
            <td>{{../customer_details.[0].cr_no}}</td>
            <td class="rtl">{{#if ../customer_details.[0].cr_no_lang2}}{{../customer_details.[0].cr_no_lang2}}{{else}}{{../customer_details.[0].cr_no}}{{/if}}</td>
            <td class="rtl" style="font-size:9px;">السجل التجاري</td>
            <td class="rtl">{{../billing_address_lang2.[0].vat}}</td>
            <td class="rtl">الرقم الضريبي</td>
        </tr>
    {{/with}}
    </table>

    {{!-- ── Items table ─────────────────────────────────────── --}}
    <table class="items-table">
        <thead>
            <tr>
                <th style="width:3%;">م<br>#</th>
                <th style="width:33%;">الوصف<br>Item Description</th>
                <th style="width:6%;">الوحدة<br>Unit</th>
                <th style="width:6%;">الكمية<br>Qty</th>
                <th style="width:10%;">سعر الوحدة<br>Unit Rate</th>
                <th style="width:10%;">المبلغ (بدون ضريبة)<br>Amount</th>
                <th style="width:6%;">نسبة ضريبة<br>VAT%</th>
                <th style="width:10%;">مبلغ ضريبة<br>VAT Amount</th>
                <th style="width:11%;">الإجمالي (شامل ضريبة)<br>Total</th>
            </tr>
        </thead>
        <tbody>
        {{#each itemdetails}}
            <tr>
                <td class="center">{{addOne @index}}</td>
                <td>
                    {{item_name}}
                    {{#if name_lang2}}
                        <span class="rtl" style="display:block; font-size:9px;">{{name_lang2}}</span>
                    {{/if}}
                    {{#if description}}
                    {{#neq description item_name}}
                        <small style="color:#555; display:block;">{{description}}</small>
                    {{/neq}}
                    {{/if}}
                </td>
                <td class="center">{{unit}}</td>
                <td class="center">{{quantity}}</td>
                <td class="cur">{{currencySymbol @root.basicdetails.[0].base_country_isocode}} {{formatAmount price ../bcdp}}</td>
                <td class="cur">{{currencySymbol @root.basicdetails.[0].base_country_isocode}} {{formatAmount taxable ../bcdp}}</td>
                <td class="center">{{vat_perc}}%</td>
                <td class="cur">{{currencySymbol @root.basicdetails.[0].base_country_isocode}} {{formatAmount vat_amt ../bcdp}}</td>
                <td class="cur">{{currencySymbol @root.basicdetails.[0].base_country_isocode}} {{formatAmount amount ../bcdp}}</td>
            </tr>
        {{/each}}
        </tbody>
    </table>

    {{!-- ── Summary + QR ──────────────────────────────────── --}}
    <table style="width:100%; margin-top:10px; border-collapse:collapse;">
        <tr>
                        <td style="vertical-align:top;">
                <table class="summary-table">
                    {{#with basicdetails.[0]}}
                    <tr>
                        <td class="lbl">Grand Total Amount (Excl. VAT)</td>
                        <td class="val" style="background-color: #e9ecef;">{{currencySymbol @root.basicdetails.[0].base_country_isocode}} {{formatAmount (divide subtotal @root.ccrate) @root.bcdp}}</td>
                        <td class="ar">المبلغ الإجمالي (بدون ضريبة)</td>
                    </tr>
                    <tr>
                        <td class="lbl">Total VAT Amount</td>
                        <td class="val" style="background-color: #e9ecef;">{{currencySymbol @root.basicdetails.[0].base_country_isocode}} {{formatAmount (divide vatamt @root.ccrate) @root.bcdp}}</td>
                        <td class="ar">إجمالي مبلغ ضريبة القيمة المضافة</td>
                    </tr>
                    <tr>
                        <td class="lbl">Grand Total Amount (Incl. VAT)</td>
                        <td class="val" style="background-color: #e9ecef;">{{currencySymbol @root.basicdetails.[0].base_country_isocode}} {{formatAmount (divide grand_total @root.ccrate) @root.bcdp}}</td>
                        <td class="ar">المبلغ الإجمالي (شامل ضريبة)</td>
                    </tr>

                    {{!-- {{#neq discount "0.00"}} --}}
                    {{#if discount}}
                    <tr>
                        <td class="lbl">Discount</td>
                        <td class="val" style="background-color: #e9ecef;">{{currencySymbol @root.basicdetails.[0].base_country_isocode}} {{formatAmount (divide discount @root.ccrate) @root.bcdp}}</td>
                        <td class="ar">الخصم</td>
                    </tr>
                    {{/if}}
                    {{!-- {{/neq}} --}}

                    {{/with}}

                    {{#each zatcadiscount}}
                    <tr>
                        <td class="lbl">
                            {{reason_name}}{{#if dld_reson}} ({{dld_reson}}){{/if}}
                        </td>
                        <td class="val" style="background-color: #e9ecef;">{{currencySymbol @root.basicdetails.[0].base_country_isocode}} {{formatAmount (divide dld @root.ccrate) @root.bcdp}}</td>
                        <td class="ar">خصم</td>
                    </tr>
                    {{/each}}

                    {{#with basicdetails.[0]}}
                    <tr class="">
                        <td class="lbl">Net Due Amount</td>
                        <td class="val" style="background-color: #e9ecef;">{{currencySymbol @root.basicdetails.[0].base_country_isocode}} {{#if balance}}{{formatAmount (divide balance @root.ccrate) @root.bcdp}}{{else}}{{formatAmount (divide grand_total @root.ccrate) @root.bcdp}}{{/if}}</td>
                        <td class="ar">المبلغ المستحق الصافي</td>
                    </tr>
                    {{/with}}
                </table>

                <div class="amount-words">
                    <div style="font-size:9px; color:#555; margin-bottom:2px; text-align:left;">Amount in words :</div>
                    {{#if bcamountinwordsar}}
                    <div class="rtl" style="text-align:center;">{{bcamountinwordsar}}</div>
                    {{/if}}
                    {{#if bcamountinwords}}
                    <div>{{bcamountinwords}}</div>
                    {{/if}}
                </div>
            </td>
        </tr>
    </table>

    {{!-- ── Bank details ─────────────────────────────────── --}}
    <table class="bank-table">
        <tr>
            <th colspan="2">Bank Details / التفاصيل المصرفية</th>
            <th>Approved By / تمت الموافقة</th>
            <th>Recieved By / فاتورة مستلم</th>
        </tr>
        <tr>
            <td class="blbl">Bank Name / <span class="rtl">اسم البنك</span></td>
            <td>{{bankdetails.name}}</td>
            <td class="signature-cell" rowspan="6">
                {{#if Seal}}
                <img src="{{Seal}}" class="sig-img" alt="Seal">
                {{/if}}
                {{#if Signature}}
                <img src="{{Signature}}" class="sig-img" alt="Signature">
                {{/if}}
                <div><span class="rtl">التوقيع مع الختم</span><br>Signature with Stamp</div>
            </td>
            <td class="signature-cell" rowspan="6">
                <div><span class="rtl">التوقيع مع الختم</span><br>Signature with Stamp</div>
            </td>
        </tr>
        <tr>
            <td class="blbl">Account Name / <span class="rtl">اسم الحساب</span></td>
            <td>{{bankdetails.acc_name}}</td>
        </tr>
        <tr>
            <td class="blbl">Account No. / <span class="rtl">رقم الحساب</span></td>
            <td>{{bankdetails.acc_no}}</td>
        </tr>
        <tr>
            <td class="blbl">IBAN / <span class="rtl">آيبان</span></td>
            <td>{{bankdetails.iban_no}}</td>
        </tr>
        <tr>
            <td class="blbl">Swift Code / <span class="rtl">رمز السرعة</span></td>
            <td>{{bankdetails.swift_no}}</td>
        </tr>
        <tr>
            <td class="blbl">Branch / <span class="rtl">فرع</span></td>
            <td>{{bankdetails.branch_name}}</td>
        </tr>
    </table>


    {{#if basicdetails.[0].terms_and_condition}}
    <div style="margin-top:10px; font-size:10px; line-height:1.6;">
        <b>Terms &amp; Conditions:</b> {{{nl2br basicdetails.[0].terms_and_condition}}}
    </div>
    {{/if}}

</div>
</body>
</html>