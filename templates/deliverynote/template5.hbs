<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Delivery Note - {{basicdetails.[0].inv_no}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: ibmplexsansarabic;
      font-size: 10px;
      color: #000;
      background: #fff;
      margin: 0 5mm;
    }

    table { border-collapse: collapse; width: 100%; table-layout: fixed; }

    /* ── Title ─────────────────────────────────────────── */
    .title {
      font-family: 'Times New Roman', Times, serif;
      text-align: center;
      font-size: 20px;
      font-weight: 400;
      padding: 4px 0 11px;
    }
    .title .en { color: #b72031; }
    .title .ar { color: #606261; direction: rtl; unicode-bidi: isolate; }

    /* ── Header boxes: customer (left) + document (right) ── */
    .hdr-wrap > tbody > tr > td { border: none; padding: 0; vertical-align: top; }

    .info td {
      border: 1px solid #bfbfbf;
      padding: 4px 6px;
      vertical-align: top;
      word-wrap: break-word;
    }
    .info .val-c { text-align: center; }

    /* ── Items ─────────────────────────────────────────── */
    .items { margin-top: 11px; }
    .items th {
      border: 1px solid #bfbfbf;
      padding: 4px 5px;
      font-weight: 400;
      text-align: center;
      vertical-align: middle;

    }
    .items th .ar { display: block; direction: rtl; unicode-bidi: isolate; }
    .items th .en { display: block;}
    .items td {
      border: 1px solid #bfbfbf;
      padding: 4px 5px;
      vertical-align: middle;
    }
    /* no rule between item rows — only the last row closes the table */
    .items tbody td { border-top: none; border-bottom: none; }
    .items tbody tr:last-child td { border-bottom: 1px solid #bfbfbf; }
    .items .sn  { text-align: center; }
    .items .qty { text-align: center; padding-right: 9px; }
    .items .uom { text-align: center; }
    .items .desc-ar { direction: rtl; unicode-bidi: isolate; }

    /* ── Signatures ────────────────────────────────────── */
    .bottom { margin-top: 130.5px; break-inside: avoid; page-break-inside: avoid; }
    .sign td { border: none; padding: 0; }
    .sign .sg {
      border-top: 1px solid #bfbfbf;
      text-align: center;
      padding-top: 17.3px;
    }
  </style>
</head>
<body>

  <!-- TITLE -->
  <div class="title">
    <span class="en">Delivery Note /</span> <span class="ar">مذكرة تسليم</span>
  </div>

  <!-- HEADER BOXES -->
  <table class="hdr-wrap">
    <colgroup>
      <col style="width:57.7%">
      <col style="width:2.3%">
      <col style="width:40%">
    </colgroup>
    <tr>
      <td>
        <table class="info">
          <colgroup>
            <col style="width:30%">
            <col style="width:70%">
          </colgroup>
          <tr>
            <td>Customer Name</td>
            <td>
              {{billing_address.[0].name}}<br>
              {{joinAddress billing_address.[0] '<br>'}}
              {{#if billing_address.[0].vat}}<br>VAT: {{billing_address.[0].vat}}{{/if}}
              {{#if customer_details.[0].cr_no}}<br>CR NO: {{customer_details.[0].cr_no}}{{/if}}
            </td>
          </tr>
          <tr>
            <td>Date</td>
            <td>{{basicdetails.[0].inv_date}}</td>
          </tr>
        </table>
      </td>
      <td></td>
      <td>
        <table class="info">
          <colgroup>
            <col style="width:30%">
            <col style="width:70%">
          </colgroup>
          <tr>
            <td>DN Number</td>
            <td class="val-c">{{basicdetails.[0].inv_no}}</td>
          </tr>
          <tr>
            <td>Invoice No</td>
            <td class="val-c">{{basicdetails.[0].invoice_no}}</td>
          </tr>
          <tr>
            <td>PO No</td>
            <td class="val-c">{{basicdetails.[0].order_no}}</td>
          </tr>
          <tr>
            <td>Supply Date</td>
            <td class="val-c">{{basicdetails.[0].sup_date}}</td>
          </tr>
          <tr>
            <td>CR NO</td>
            <td class="val-c">{{branch.[0].cr_no}}</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <!-- ITEMS -->
  <table class="items">
    <colgroup>
      <col style="width:5%">
      <col style="width:15%">
      <col style="width:60%">
      <col style="width:10%">
      <col style="width:10%">
    </colgroup>
    <thead>
      <tr>
        <th><span class="ar">م</span><span class="en">S.N</span></th>
        <th><span class="ar">رمز</span><span class="en">Code</span></th>
        <th><span class="ar">الوصف</span><span class="en">Description</span></th>
        <th><span class="ar">الكمية</span><span class="en">QTY</span></th>
        <th><span class="ar">الوحدة</span><span class="en">UOM</span></th>
      </tr>
    </thead>
    <tbody>
      {{#each itemdetails}}
      <tr>
        <td class="sn">{{addOne @index}}</td>
        <td>{{item_code}}</td>
        <td>{{item_name}}{{#if name_lang2}}<span class="desc-ar">{{name_lang2}}</span>{{/if}}{{#if description}}<span class="desc-ar">{{description}}</span>{{/if}}</td>
        <td class="qty">{{quantity}}</td>
        <td class="uom">{{unit}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- SIGNATURES -->
  <div class="bottom">
    <table class="sign">
      <colgroup>
        <col style="width:29.84%">
        <col style="width:5.29%">
        <col style="width:29.84%">
        <col style="width:5.29%">
        <col style="width:29.84%">
      </colgroup>
      <tr>
        <td class="sg">Prepared By</td>
        <td></td>
        <td class="sg">Delivered By</td>
        <td></td>
        <td class="sg">Received By</td>
      </tr>
    </table>
  </div>

</body>
</html>
